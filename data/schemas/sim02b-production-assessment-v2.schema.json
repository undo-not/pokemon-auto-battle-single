{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pokemon-auto-battle/schemas/sim02b-production-assessment-v2.schema.json",
  "title": "SIM-02B Production Promotion Negative Assessment V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "assessment_kind",
    "source_compiler_id",
    "source_report_hash",
    "diagnostic_artifact_manifest_hash",
    "target_pool_hash",
    "catalog_hash",
    "ruleset_hash",
    "target_capability_set_hash",
    "source_policy",
    "status",
    "promotion_candidate",
    "denominator_final",
    "catalog_emit_eligible",
    "verified_target_mapping",
    "development_scenario_coverage",
    "verified_grounding_conformance",
    "engine_probe_pass",
    "external_holdout_novel_gap_count",
    "silent_fallback_count",
    "readiness_seal_hash",
    "blockers",
    "assessment_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "assessment_id": {
      "type": "string",
      "pattern": "^production-assessment-v2:[0-9a-f]{64}$"
    },
    "assessment_kind": {"const": "v1_diagnostic_no_go"},
    "source_compiler_id": {"const": "source-to-capability-bundle-v1"},
    "source_report_hash": {"$ref": "#/$defs/sha256"},
    "diagnostic_artifact_manifest_hash": {"$ref": "#/$defs/sha256"},
    "target_pool_hash": {"$ref": "#/$defs/sha256"},
    "catalog_hash": {"$ref": "#/$defs/sha256"},
    "ruleset_hash": {"$ref": "#/$defs/sha256"},
    "target_capability_set_hash": {"$ref": "#/$defs/sha256"},
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_status", "access_scope", "redistribution"],
      "properties": {
        "license_status": {"const": "unverified"},
        "access_scope": {"const": "local_only"},
        "redistribution": {"const": "prohibited"}
      }
    },
    "status": {"const": "no_go"},
    "promotion_candidate": {"const": false},
    "denominator_final": {"const": false},
    "catalog_emit_eligible": {"const": false},
    "verified_target_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "rate_ppm"],
      "properties": {
        "numerator": {"const": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "rate_ppm": {"const": 0}
      }
    },
    "development_scenario_coverage": {"$ref": "#/$defs/undefinedRate"},
    "verified_grounding_conformance": {"$ref": "#/$defs/undefinedRate"},
    "engine_probe_pass": {"$ref": "#/$defs/undefinedRate"},
    "external_holdout_novel_gap_count": {"type": "null"},
    "silent_fallback_count": {"type": "integer", "minimum": 0},
    "readiness_seal_hash": {"type": "null"},
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blocker"}
    },
    "assessment_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "undefinedRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "rate_ppm"],
      "properties": {
        "numerator": {"type": "null"},
        "denominator": {"type": "null"},
        "rate_ppm": {"type": "null"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "code",
        "subject",
        "evidence_required",
        "restart_condition"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "subject": {"type": "string", "minLength": 1},
        "evidence_required": {"type": "string", "minLength": 1},
        "restart_condition": {"type": "string", "minLength": 1}
      }
    }
  }
}
