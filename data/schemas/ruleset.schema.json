{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:sim01-ruleset:1",
  "title": "SIM-01 RuleSet Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "engine_semantics_version",
    "name",
    "battle_format",
    "team_size",
    "level",
    "item_clause",
    "max_turns",
    "damage_rolls",
    "critical",
    "residuals",
    "item_rules",
    "ability_rules",
    "supported_mechanics",
    "unsupported_mechanics",
    "provisional_rules",
    "provisional_decision_ids",
    "source_manifest_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "ruleset_id": {
      "$ref": "#/$defs/stableId"
    },
    "engine_semantics_version": {
      "$ref": "#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "battle_format": {
      "const": "singles_3v3"
    },
    "team_size": {
      "const": 3
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "item_clause": {
      "type": "boolean"
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1
    },
    "damage_rolls": {
      "const": [85, 86, 87, 88, 89, 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100]
    },
    "critical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chance_numerator",
        "chance_denominator",
        "multiplier_numerator",
        "multiplier_denominator"
      ],
      "properties": {
        "chance_numerator": {
          "type": "integer",
          "minimum": 0
        },
        "chance_denominator": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier_numerator": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier_denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "residuals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["burn", "poison", "leftovers"],
      "properties": {
        "burn": {
          "$ref": "#/$defs/positiveRational"
        },
        "poison": {
          "$ref": "#/$defs/positiveRational"
        },
        "leftovers": {
          "$ref": "#/$defs/positiveRational"
        }
      }
    },
    "item_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sitrus_berry", "focus_sash"],
      "properties": {
        "sitrus_berry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activation_hp_numerator",
            "activation_hp_denominator",
            "heal_numerator",
            "heal_denominator"
          ],
          "properties": {
            "activation_hp_numerator": {
              "type": "integer",
              "minimum": 1
            },
            "activation_hp_denominator": {
              "type": "integer",
              "minimum": 1
            },
            "heal_numerator": {
              "type": "integer",
              "minimum": 1
            },
            "heal_denominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "focus_sash": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surviving_hp"],
          "properties": {
            "surviving_hp": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "ability_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rough_skin", "technician", "overgrow", "blaze"],
      "properties": {
        "rough_skin": {
          "$ref": "#/$defs/positiveRational"
        },
        "technician": {
          "$ref": "#/$defs/powerThresholdModifier"
        },
        "overgrow": {
          "$ref": "#/$defs/hpThresholdModifier"
        },
        "blaze": {
          "$ref": "#/$defs/hpThresholdModifier"
        }
      }
    },
    "mega_evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_uses_per_side",
        "activation_timing",
        "requires_active",
        "consumes_item"
      ],
      "properties": {
        "max_uses_per_side": {"const": 1},
        "activation_timing": {"const": "before_move_ordering"},
        "requires_active": {"const": true},
        "consumes_item": {"const": false}
      }
    },
    "supported_mechanics": {
      "$ref": "#/$defs/uniqueStableIds"
    },
    "unsupported_mechanics": {
      "$ref": "#/$defs/uniqueStableIds"
    },
    "provisional_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provisional_decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PD-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "source_manifest_ids": {
      "$ref": "#/$defs/uniqueStableIds"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uniqueStableIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "positiveRational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "powerThresholdModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["power_limit", "multiplier_numerator", "multiplier_denominator"],
      "properties": {
        "power_limit": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier_numerator": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier_denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hpThresholdModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp_numerator",
        "hp_denominator",
        "multiplier_numerator",
        "multiplier_denominator"
      ],
      "properties": {
        "hp_numerator": {
          "type": "integer",
          "minimum": 1
        },
        "hp_denominator": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier_numerator": {
          "type": "integer",
          "minimum": 1
        },
        "multiplier_denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
