{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-production-trust-policy-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_epoch",
    "project_id",
    "purpose",
    "environment",
    "attestation_scope",
    "algorithm",
    "namespace",
    "valid_from",
    "expires_at",
    "minimum_attestation_policy_epoch",
    "issuers",
    "revoked_attestation_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"$ref": "#/$defs/stableId"},
    "policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "project_id": {"const": "champions_sim"},
    "purpose": {"const": "production_source_approval"},
    "environment": {"const": "private_match"},
    "attestation_scope": {"const": "production_champions"},
    "algorithm": {"const": "ssh-ed25519"},
    "namespace": {"const": "champions-sim-production-trust-v1"},
    "valid_from": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "minimum_attestation_policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "issuers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/issuer"}
    },
    "revoked_attestation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "public_key",
        "fingerprint_sha256",
        "status",
        "not_before",
        "expires_at"
      ],
      "properties": {
        "key_id": {"$ref": "#/$defs/stableId"},
        "algorithm": {"const": "ssh-ed25519"},
        "public_key": {
          "type": "string",
          "pattern": "^ssh-ed25519 [A-Za-z0-9+/]+={0,2}$"
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]+$"
        },
        "status": {"enum": ["active", "revoked"]},
        "not_before": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "status", "keys"],
      "properties": {
        "issuer_id": {"$ref": "#/$defs/stableId"},
        "status": {"enum": ["active", "revoked"]},
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/key"}
        }
      }
    }
  }
}
