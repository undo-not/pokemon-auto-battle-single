{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:ai-env-observation:1",
  "title": "ChampionSim AI environment observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "battle_id",
    "ruleset_id",
    "viewer",
    "turn",
    "phase",
    "instant_fields",
    "public_history",
    "legal_action_mask",
    "provenance",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"$ref": "#/$defs/stableId"},
    "battle_id": {"$ref": "#/$defs/stableId"},
    "ruleset_id": {"$ref": "#/$defs/stableId"},
    "viewer": {"enum": ["p1", "p2"]},
    "turn": {"type": ["integer", "null"], "minimum": 0},
    "phase": {"type": ["string", "null"]},
    "instant_fields": {
      "type": "array",
      "items": {"$ref": "#/$defs/groundedField"}
    },
    "public_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/publicEvent"}
    },
    "legal_action_mask": {"$ref": "#/$defs/legalMask"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "artifactIds": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactRef"},
      "uniqueItems": true
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^capture-[0-9a-f]{64}/(?:screenshot|ui-hierarchy)$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^capture-[0-9a-f]{64}$"
    },
    "groundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "source", "value", "confidence_ppm", "artifact_ids", "note"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:/turn|/phase|/field/conditions|/(?:own|opponent)/(?:active|team/[0-9]+)/(?:pokemon_id|level|status_id|stat_stages|types|item_id|ability_id|moves|mega_evolved|hp_bar_range_millionths|hp|max_hp|hp_fraction_millionths|stats|move_pp))$"
        },
        "status": {"enum": ["observed", "inferred", "unknown", "conflict"]},
        "source": {
          "enum": ["simulator", "screen_region", "ui_metadata", "public_history", "manual", "inference"]
        },
        "value": {},
        "confidence_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "note": {"type": ["string", "null"]}
      }
    },
    "publicEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "turn", "kind", "actor", "subject", "details", "evidence_artifact_ids"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "turn": {"type": "integer", "minimum": 0},
        "kind": {"$ref": "#/$defs/stableId"},
        "actor": {"enum": ["p1", "p2", null]},
        "subject": {"type": ["string", "null"]},
        "details": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"type": ["string", "integer", "boolean", "null"]}
            ],
            "items": false
          }
        },
        "evidence_artifact_ids": {"$ref": "#/$defs/artifactIds"}
      }
    },
    "legalMask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "request_id", "action_ids", "legal", "source", "evidence_artifact_ids", "reason"],
      "properties": {
        "status": {"enum": ["known", "unknown", "all_illegal"]},
        "request_id": {"oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
        "action_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "legal": {"type": "array", "items": {"type": "boolean"}},
        "source": {"enum": ["simulator", "grounded_capture"]},
        "evidence_artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "unknown"}}
          },
          "then": {
            "properties": {
              "request_id": {"const": null},
              "action_ids": {"maxItems": 0},
              "legal": {"maxItems": 0},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "all_illegal"}}
          },
          "then": {
            "properties": {
              "action_ids": {"minItems": 1},
              "legal": {
                "minItems": 1,
                "items": {"const": false}
              },
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "capture_ids", "artifact_refs", "grounding_trace_id"],
      "properties": {
        "source": {"enum": ["simulator", "grounded_capture"]},
        "capture_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/captureId"},
          "uniqueItems": true
        },
        "artifact_refs": {"$ref": "#/$defs/artifactIds"},
        "grounding_trace_id": {
          "oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]
        }
      }
    }
  }
}
