{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:pokemon-showdown-dependency:1",
  "title": "Pinned Pokemon Showdown dependency v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "upstream", "runtime", "runtime_dependencies", "formats", "source_files", "build"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "commit", "tree", "license", "license_file", "license_sha256"],
      "properties": {
        "repository_url": {"const": "https://github.com/smogon/pokemon-showdown.git"},
        "commit": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"},
        "license": {"const": "MIT"},
        "license_file": {"$ref": "#/$defs/path"},
        "license_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_node_major", "install_command", "build_command"],
      "properties": {
        "minimum_node_major": {"type": "integer", "minimum": 22},
        "install_command": {"const": ["npm", "ci", "--omit=optional"]},
        "build_command": {"const": ["node", "build"]}
      }
    },
    "runtime_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license", "package_file", "package_sha256", "license_file", "license_sha256", "runtime_files"],
        "properties": {
          "name": {"$ref": "#/$defs/id"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "license": {"$ref": "#/$defs/text"},
          "package_file": {"$ref": "#/$defs/path"},
          "package_sha256": {"$ref": "#/$defs/sha256"},
          "license_file": {"$ref": "#/$defs/path"},
          "license_sha256": {"$ref": "#/$defs/sha256"},
          "runtime_files": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"$ref": "#/$defs/path"},
            "additionalProperties": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "mod", "regulation"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/text"},
          "mod": {"$ref": "#/$defs/id"},
          "regulation": {"$ref": "#/$defs/text"}
        }
      }
    },
    "source_files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/path"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "include_roots", "include_files", "extension", "file_count", "fingerprint_sha256"],
      "properties": {
        "algorithm": {"const": "sha256-path-nul-sha256-lf-v1"},
        "include_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "include_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "extension": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"},
        "file_count": {"type": "integer", "minimum": 1},
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]+$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
