{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:sim02b-scenario-corpus:2.1",
  "title": "SIM-02B Evidence-bound Engine Scenario Corpus V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_role",
    "target_capability_set_hash",
    "catalog_hash",
    "ruleset_hash",
    "scenarios",
    "corpus_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "corpus_role": {"enum": ["development", "external_holdout"]},
    "target_capability_set_hash": {"$ref": "#/$defs/sha"},
    "catalog_hash": {"$ref": "#/$defs/sha"},
    "ruleset_hash": {"$ref": "#/$defs/sha"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenario"}
    },
    "corpus_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "partition_role",
        "capability_id",
        "target_capability_set_hash",
        "initial_state_hash",
        "choice_sequence_hash",
        "seed",
        "rng_algorithm_id",
        "catalog_hash",
        "ruleset_hash",
        "replay_hash",
        "replay_execution_hash",
        "witness_step_index",
        "witness_event_index",
        "witness_event_kind",
        "witness_event_hash",
        "source_lineage_ids",
        "collection_lineage_ids",
        "authoring_lineage_ids",
        "scenario_hash"
      ],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/id"},
        "partition_role": {"enum": ["development", "external_holdout"]},
        "capability_id": {"$ref": "#/$defs/id"},
        "target_capability_set_hash": {"$ref": "#/$defs/sha"},
        "initial_state_hash": {"$ref": "#/$defs/sha"},
        "choice_sequence_hash": {"$ref": "#/$defs/sha"},
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "rng_algorithm_id": {"const": "splitmix64-v1"},
        "catalog_hash": {"$ref": "#/$defs/sha"},
        "ruleset_hash": {"$ref": "#/$defs/sha"},
        "replay_hash": {"$ref": "#/$defs/sha"},
        "replay_execution_hash": {"$ref": "#/$defs/sha"},
        "witness_step_index": {"type": "integer", "minimum": 0},
        "witness_event_index": {"type": "integer", "minimum": 0},
        "witness_event_kind": {"$ref": "#/$defs/id"},
        "witness_event_hash": {"$ref": "#/$defs/sha"},
        "source_lineage_ids": {"$ref": "#/$defs/ids"},
        "collection_lineage_ids": {"$ref": "#/$defs/ids"},
        "authoring_lineage_ids": {"$ref": "#/$defs/ids"},
        "scenario_hash": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
