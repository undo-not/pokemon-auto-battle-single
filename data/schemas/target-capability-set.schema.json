{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:target-capability-set:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "capability_set_id", "target_pool_manifest_id", "target_pool_manifest_hash", "catalog_hash", "ruleset_hash", "semantic_registry_id", "semantic_registry_hash", "closure_algorithm_version", "denominator_final", "entity_capability_refs", "capabilities", "grounding_requirements", "unresolved_requirements", "development_records", "source_manifest_ids"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "capability_set_id": {"$ref": "#/$defs/id"}, "target_pool_manifest_id": {"$ref": "#/$defs/id"}, "target_pool_manifest_hash": {"$ref": "#/$defs/sha"}, "catalog_hash": {"$ref": "#/$defs/sha"}, "ruleset_hash": {"$ref": "#/$defs/sha"}, "semantic_registry_id": {"$ref": "#/$defs/id"}, "semantic_registry_hash": {"$ref": "#/$defs/sha"}, "closure_algorithm_version": {"$ref": "#/$defs/id"}, "denominator_final": {"type": "boolean"},
    "entity_capability_refs": {"type": "array", "items": {"$ref": "#/$defs/entityRef"}}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}}, "grounding_requirements": {"type": "array", "items": {"$ref": "#/$defs/groundingRequirement"}}, "unresolved_requirements": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}}, "development_records": {"type": "array", "items": {"$ref": "#/$defs/recordIdentity"}}, "source_manifest_ids": {"$ref": "#/$defs/ids"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"}, "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"$ref": "#/$defs/id"}, "value": {"type": ["string", "integer", "boolean", "null"]}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["effect_id", "trigger", "target", "resolution_context", "ruleset_branch"], "properties": {"effect_id": {"$ref": "#/$defs/id"}, "trigger": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "resolution_context": {"type": "array", "items": {"$ref": "#/$defs/context"}}, "ruleset_branch": {"$ref": "#/$defs/id"}}},
    "entityRef": {"type": "object", "additionalProperties": false, "required": ["ref_id", "entity_kind", "entity_id", "owner_entity_id", "capability_id", "legal_status", "observed_in_corpus", "source_record_ids", "evidence_ref_ids"], "properties": {"ref_id": {"$ref": "#/$defs/id"}, "entity_kind": {"enum": ["move", "ability", "item", "mechanic", "interaction"]}, "entity_id": {"$ref": "#/$defs/id"}, "owner_entity_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "capability_id": {"$ref": "#/$defs/id"}, "legal_status": {"const": "legal"}, "observed_in_corpus": {"type": "boolean"}, "source_record_ids": {"$ref": "#/$defs/ids"}, "evidence_ref_ids": {"$ref": "#/$defs/ids"}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["capability_id", "signature", "reachability", "entity_ref_ids", "grounding_requirement_ids"], "properties": {"capability_id": {"$ref": "#/$defs/id"}, "signature": {"$ref": "#/$defs/signature"}, "reachability": {"enum": ["legal", "observed", "mandatory"]}, "entity_ref_ids": {"$ref": "#/$defs/ids"}, "grounding_requirement_ids": {"$ref": "#/$defs/ids"}}},
    "groundingRequirement": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "capability_id", "boundary_id", "scope", "entity_ref_id", "allowed_evidence_kinds"], "properties": {"requirement_id": {"$ref": "#/$defs/id"}, "capability_id": {"$ref": "#/$defs/id"}, "boundary_id": {"$ref": "#/$defs/id"}, "scope": {"enum": ["shared_semantics", "entity_reference"]}, "entity_ref_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "allowed_evidence_kinds": {"type": "array", "items": {"enum": ["actual_bluestacks", "official_primary", "published_reference"]}, "uniqueItems": true}}},
    "unresolved": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "kind", "subject_ref", "evidence_ref_ids", "blocker_code"], "properties": {"requirement_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "subject_ref": {"type": "string", "minLength": 1}, "evidence_ref_ids": {"$ref": "#/$defs/ids"}, "blocker_code": {"type": "string", "minLength": 1}}},
    "recordIdentity": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_hash"], "properties": {"record_id": {"$ref": "#/$defs/id"}, "record_hash": {"$ref": "#/$defs/sha"}}}
  }
}
