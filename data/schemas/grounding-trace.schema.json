{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:grounding-trace:1",
  "title": "ChampionSim partial-observation grounding trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "format_id",
    "viewer",
    "reference_replay_hash",
    "frames",
    "status",
    "blockers",
    "local_research_only",
    "distribution_allowed"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "trace_id": {"$ref": "#/$defs/stableId"},
    "format_id": {"$ref": "#/$defs/stableId"},
    "viewer": {"enum": ["p1", "p2"]},
    "reference_replay_hash": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    },
    "status": {"enum": ["incomplete", "conformant", "nonconformant"]},
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "local_research_only": {"const": true},
    "distribution_allowed": {"const": false}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256Prefixed": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "captureId": {"type": "string", "pattern": "^capture-[0-9a-f]{64}$"},
    "artifactIds": {
      "type": "array",
      "items": {"$ref": "#/$defs/stableId"},
      "uniqueItems": true
    },
    "groundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "source",
        "value",
        "confidence_ppm",
        "artifact_ids",
        "note"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "status": {"enum": ["observed", "inferred", "unknown", "conflict"]},
        "source": {
          "enum": ["screen_region", "ui_metadata", "public_history", "manual", "inference"]
        },
        "value": {},
        "confidence_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "note": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["status"],
            "properties": {"status": {"const": "unknown"}}
          },
          "then": {
            "properties": {
              "value": {"const": null},
              "confidence_ppm": {"const": 0}
            }
          }
        }
      ]
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "verdict", "expected", "observed", "artifact_ids", "note"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "verdict": {"enum": ["match", "mismatch", "unknown", "not_applicable"]},
        "expected": {},
        "observed": {},
        "artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "note": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["verdict"],
            "properties": {"verdict": {"enum": ["match", "mismatch"]}}
          },
          "then": {"properties": {"artifact_ids": {"minItems": 1}}}
        }
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "capture_id", "capture_manifest_hash", "observed_at", "fields", "conformance"],
      "properties": {
        "frame_id": {"$ref": "#/$defs/stableId"},
        "capture_id": {"$ref": "#/$defs/captureId"},
        "capture_manifest_hash": {"$ref": "#/$defs/sha256Prefixed"},
        "observed_at": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/groundedField"}},
        "conformance": {"type": "array", "items": {"$ref": "#/$defs/conformance"}}
      }
    }
  }
}
