{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-production-promotion-input-manifest-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "purpose",
    "authorization_status",
    "source_scope",
    "source_resolution_set_hash",
    "source_manifests",
    "artifact_bindings",
    "replay_artifact_bindings",
    "grounding_evidence_refs",
    "runtime_evidence",
    "request_binding_hash",
    "input_content_hash"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "manifest_id": {
      "type": "string",
      "pattern": "^production-promotion-input-manifest-[0-9a-f]{64}$"
    },
    "purpose": {"const": "production_promotion_request_rehydration"},
    "authorization_status": {"const": "not_authorization"},
    "source_scope": {
      "enum": ["test_authoritative", "production_champions"]
    },
    "source_resolution_set_hash": {"$ref": "#/$defs/sha256"},
    "source_manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceManifestInput"}
    },
    "artifact_bindings": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactBinding"}
    },
    "replay_artifact_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/replayBinding"}
    },
    "grounding_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/recordReference"}
    },
    "runtime_evidence": {"$ref": "#/$defs/runtimeEvidence"},
    "request_binding_hash": {"$ref": "#/$defs/sha256"},
    "input_content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePosixPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!//)(?!.*\\\\)(?!.*:)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)\\s)(?!.*[.\\s](?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest_id", "artifact_id"],
      "properties": {
        "source_manifest_id": {"$ref": "#/$defs/stableId"},
        "artifact_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "sourceManifestInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "source_manifest_id",
        "byte_count",
        "sha256",
        "manifest_hash",
        "resolution_hash"
      ],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePosixPath"},
        "source_manifest_id": {"$ref": "#/$defs/stableId"},
        "byte_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "manifest_hash": {"$ref": "#/$defs/sha256"},
        "resolution_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactContentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_id",
        "artifact_id",
        "artifact_role",
        "relative_path",
        "media_type",
        "byte_count",
        "sha256"
      ],
      "properties": {
        "source_manifest_id": {"$ref": "#/$defs/stableId"},
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "artifact_role": {"const": "source_data"},
        "relative_path": {"$ref": "#/$defs/relativePosixPath"},
        "media_type": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_role", "artifact"],
      "properties": {
        "binding_role": {
          "enum": [
            "regulation",
            "target_pool",
            "catalog",
            "ruleset",
            "mapping_evidence",
            "development_construction_corpus",
            "external_holdout_construction_corpus",
            "grounding_assertions",
            "development_scenario_corpus",
            "external_holdout_scenario_corpus",
            "timing_evidence"
          ]
        },
        "artifact": {"$ref": "#/$defs/artifactContentIdentity"}
      }
    },
    "replayBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "artifact"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/stableId"},
        "artifact": {"$ref": "#/$defs/artifactContentIdentity"}
      }
    },
    "recordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref_id",
        "source_manifest_id",
        "artifact_id",
        "json_pointer",
        "record_sha256"
      ],
      "properties": {
        "evidence_ref_id": {"$ref": "#/$defs/stableId"},
        "source_manifest_id": {"$ref": "#/$defs/stableId"},
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:$|/)"
        },
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "required_arguments",
        "current_trust_context_required",
        "development_scenario_corpus",
        "external_holdout_scenario_corpus",
        "replay_scenario_ids",
        "validated_grounding_trace_ids"
      ],
      "properties": {
        "evidence_status": {"const": "references_only_not_embedded"},
        "required_arguments": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"const": "current_trust_context"},
            {"const": "development_scenario_corpus"},
            {"const": "external_holdout_scenario_corpus"},
            {"const": "replays"},
            {"const": "validated_traces"}
          ],
          "items": false
        },
        "current_trust_context_required": {"const": true},
        "development_scenario_corpus": {"$ref": "#/$defs/locator"},
        "external_holdout_scenario_corpus": {"$ref": "#/$defs/locator"},
        "replay_scenario_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "validated_grounding_trace_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    }
  }
}
