{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-production-trust-enrollment-registry-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "registry_id",
    "project_id",
    "purpose",
    "environment",
    "attestation_scope",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "domain": {"const": "champions-sim.production-trust-enrollment.v1"},
    "registry_id": {"$ref": "#/$defs/stableId"},
    "project_id": {"const": "champions_sim"},
    "purpose": {"const": "production_source_approval"},
    "environment": {"const": "private_match"},
    "attestation_scope": {"const": "production_champions"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enrollment_id",
        "status",
        "policy_id",
        "policy_sha256",
        "ssh_keygen_sha256",
        "ledger_instance_id",
        "ledger_path_binding_hash",
        "minimum_policy_epoch",
        "not_before",
        "expires_at"
      ],
      "properties": {
        "enrollment_id": {"$ref": "#/$defs/stableId"},
        "status": {"enum": ["active", "revoked"]},
        "policy_id": {"$ref": "#/$defs/stableId"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "ssh_keygen_sha256": {"$ref": "#/$defs/sha256"},
        "ledger_instance_id": {"$ref": "#/$defs/stableId"},
        "ledger_path_binding_hash": {"$ref": "#/$defs/sha256"},
        "minimum_policy_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "not_before": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
