{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:source-to-capability-report:1",
  "title": "SIM-02 Source-to-Capability Compiler Decision Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_id",
    "regulation_id",
    "regulation_revision",
    "status",
    "operational_success",
    "candidate_ready",
    "denominator_final",
    "source_policy",
    "counts",
    "hashes",
    "artifacts",
    "blocking_reasons",
    "report_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "compiler_id": {"const": "source-to-capability-bundle-v1"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "regulation_revision": {"$ref": "#/$defs/stableId"},
    "status": {"enum": ["candidate", "no_go"]},
    "operational_success": {"const": true},
    "candidate_ready": {"type": "boolean"},
    "denominator_final": {"type": "boolean"},
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_status", "access_scope", "redistribution"],
      "properties": {
        "license_status": {"enum": ["verified", "unverified"]},
        "access_scope": {"enum": ["approved", "local_only"]},
        "redistribution": {"enum": ["allowed", "prohibited"]}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_members",
        "mapping_resolved",
        "mapping_unresolved",
        "mapping_conflict",
        "catalog_species",
        "catalog_moves",
        "catalog_abilities",
        "catalog_items",
        "semantic_selectors",
        "semantic_unsupported_selectors",
        "target_capability_rows",
        "execution_gaps",
        "grounding_assertions",
        "probe_explicit_unsupported",
        "probe_unexpected_errors",
        "silent_fallbacks",
        "blocking_reasons"
      ],
      "properties": {
        "target_members": {"type": "integer", "minimum": 1},
        "mapping_resolved": {"$ref": "#/$defs/nonNegativeInteger"},
        "mapping_unresolved": {"$ref": "#/$defs/nonNegativeInteger"},
        "mapping_conflict": {"$ref": "#/$defs/nonNegativeInteger"},
        "catalog_species": {"$ref": "#/$defs/nonNegativeInteger"},
        "catalog_moves": {"$ref": "#/$defs/nonNegativeInteger"},
        "catalog_abilities": {"$ref": "#/$defs/nonNegativeInteger"},
        "catalog_items": {"$ref": "#/$defs/nonNegativeInteger"},
        "semantic_selectors": {"$ref": "#/$defs/nonNegativeInteger"},
        "semantic_unsupported_selectors": {"$ref": "#/$defs/nonNegativeInteger"},
        "target_capability_rows": {"$ref": "#/$defs/nonNegativeInteger"},
        "execution_gaps": {"$ref": "#/$defs/nonNegativeInteger"},
        "grounding_assertions": {"$ref": "#/$defs/nonNegativeInteger"},
        "probe_explicit_unsupported": {"$ref": "#/$defs/nonNegativeInteger"},
        "probe_unexpected_errors": {"$ref": "#/$defs/nonNegativeInteger"},
        "silent_fallbacks": {"$ref": "#/$defs/nonNegativeInteger"},
        "blocking_reasons": {"type": "integer", "minimum": 0}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_intake",
        "runtime_catalog",
        "mapping_evidence",
        "production_catalog_input",
        "semantic_compilation",
        "target_pool_manifest",
        "target_capability_set",
        "execution_compilation",
        "probe_plan",
        "probe_report",
        "grounding_resolution",
        "mechanic_coverage_matrix"
      ],
      "properties": {
        "catalog_intake": {"$ref": "#/$defs/sha256"},
        "runtime_catalog": {"$ref": "#/$defs/sha256"},
        "mapping_evidence": {"$ref": "#/$defs/sha256"},
        "production_catalog_input": {"$ref": "#/$defs/sha256"},
        "semantic_compilation": {"$ref": "#/$defs/sha256"},
        "target_pool_manifest": {"$ref": "#/$defs/sha256"},
        "target_capability_set": {"$ref": "#/$defs/sha256"},
        "execution_compilation": {"$ref": "#/$defs/sha256"},
        "probe_plan": {"$ref": "#/$defs/sha256"},
        "probe_report": {"$ref": "#/$defs/sha256"},
        "grounding_resolution": {"$ref": "#/$defs/sha256"},
        "mechanic_coverage_matrix": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_name", "sha256", "byte_count"],
        "properties": {
          "file_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          },
          "sha256": {"$ref": "#/$defs/sha256"},
          "byte_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "blocking_reasons": {
      "type": "array",
      "minItems": 0,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "report_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate_ready": {"const": true}}},
      "then": {
        "properties": {
          "status": {"const": "candidate"},
          "denominator_final": {"const": true},
          "blocking_reasons": {"maxItems": 0},
          "source_policy": {
            "properties": {
              "license_status": {"const": "verified"},
              "access_scope": {"const": "approved"},
              "redistribution": {"const": "allowed"}
            }
          },
          "counts": {
            "properties": {
              "mapping_unresolved": {"const": 0},
              "mapping_conflict": {"const": 0},
              "semantic_unsupported_selectors": {"const": 0},
              "target_capability_rows": {"minimum": 1},
              "execution_gaps": {"const": 0},
              "grounding_assertions": {"minimum": 1},
              "probe_explicit_unsupported": {"const": 0},
              "probe_unexpected_errors": {"const": 0},
              "silent_fallbacks": {"const": 0},
              "blocking_reasons": {"const": 0}
            }
          }
        }
      },
      "else": {
        "properties": {
          "status": {"const": "no_go"},
          "blocking_reasons": {"minItems": 1},
          "counts": {
            "properties": {
              "blocking_reasons": {"minimum": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
