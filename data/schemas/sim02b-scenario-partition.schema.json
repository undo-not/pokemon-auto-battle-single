{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:sim02b-scenario-partition:2",
  "title": "SIM-02B Development and External Holdout Partition Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "target_capability_set_hash",
    "catalog_hash",
    "ruleset_hash",
    "development_corpus_id",
    "development_corpus_hash",
    "external_holdout_corpus_id",
    "external_holdout_corpus_hash",
    "development_scenario_hashes",
    "external_holdout_scenario_hashes",
    "development_replay_hashes",
    "external_holdout_replay_hashes",
    "development_source_lineage_ids",
    "external_holdout_source_lineage_ids",
    "development_collection_lineage_ids",
    "external_holdout_collection_lineage_ids",
    "development_authoring_lineage_ids",
    "external_holdout_authoring_lineage_ids",
    "scenario_hash_overlap",
    "replay_hash_overlap",
    "source_lineage_overlap",
    "collection_lineage_overlap",
    "authoring_lineage_overlap",
    "partition_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "target_capability_set_hash": {"$ref": "#/$defs/sha"},
    "catalog_hash": {"$ref": "#/$defs/sha"},
    "ruleset_hash": {"$ref": "#/$defs/sha"},
    "development_corpus_id": {"$ref": "#/$defs/id"},
    "development_corpus_hash": {"$ref": "#/$defs/sha"},
    "external_holdout_corpus_id": {"$ref": "#/$defs/id"},
    "external_holdout_corpus_hash": {"$ref": "#/$defs/sha"},
    "development_scenario_hashes": {"$ref": "#/$defs/hashes"},
    "external_holdout_scenario_hashes": {"$ref": "#/$defs/hashes"},
    "development_replay_hashes": {"$ref": "#/$defs/hashes"},
    "external_holdout_replay_hashes": {"$ref": "#/$defs/hashes"},
    "development_source_lineage_ids": {"$ref": "#/$defs/ids"},
    "external_holdout_source_lineage_ids": {"$ref": "#/$defs/ids"},
    "development_collection_lineage_ids": {"$ref": "#/$defs/ids"},
    "external_holdout_collection_lineage_ids": {"$ref": "#/$defs/ids"},
    "development_authoring_lineage_ids": {"$ref": "#/$defs/ids"},
    "external_holdout_authoring_lineage_ids": {"$ref": "#/$defs/ids"},
    "scenario_hash_overlap": {"$ref": "#/$defs/emptyHashes"},
    "replay_hash_overlap": {"$ref": "#/$defs/emptyHashes"},
    "source_lineage_overlap": {"$ref": "#/$defs/emptyIds"},
    "collection_lineage_overlap": {"$ref": "#/$defs/emptyIds"},
    "authoring_lineage_overlap": {"$ref": "#/$defs/emptyIds"},
    "partition_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha"}
    },
    "emptyHashes": {
      "type": "array",
      "maxItems": 0,
      "items": {"$ref": "#/$defs/sha"}
    },
    "emptyIds": {
      "type": "array",
      "maxItems": 0,
      "items": {"$ref": "#/$defs/id"}
    }
  }
}
