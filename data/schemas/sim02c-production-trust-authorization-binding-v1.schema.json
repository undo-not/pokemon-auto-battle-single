{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:sim02c-production-trust-authorization-binding:1",
  "title": "SIM-02C Stable Production Trust Authorization Binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "binding_domain", "authorization_status",
    "current_trust_context_required", "trust_receipt_schema_version",
    "trust_enrollment_schema_version", "trust_enrollment_domain",
    "trust_registry_id", "trust_registry_sha256", "trust_enrollment_id",
    "trust_enrollment_binding_hash", "trust_enrollment_policy_id",
    "trust_enrollment_policy_sha256", "trust_enrollment_ssh_keygen_sha256",
    "trust_enrollment_ledger_instance_id",
    "trust_enrollment_ledger_path_binding_hash",
    "trust_enrollment_minimum_policy_epoch", "trust_enrollment_not_before",
    "trust_enrollment_expires_at", "domain",
    "attestation_id", "attestation_hash", "subject_hash", "policy_id",
    "policy_epoch", "policy_sha256", "issuer_id", "key_id",
    "key_fingerprint_sha256", "algorithm", "namespace", "ledger_binding_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "binding_domain": {"const": "champions-sim.production-trust-authorization-binding.v1"},
    "authorization_status": {"const": "not_authorization"},
    "current_trust_context_required": {"const": true},
    "trust_receipt_schema_version": {"const": "1.0.0"},
    "trust_enrollment_schema_version": {"const": "1.0.0"},
    "trust_enrollment_domain": {"const": "champions-sim.production-trust-enrollment.v1"},
    "trust_registry_id": {"$ref": "#/$defs/id"},
    "trust_registry_sha256": {"$ref": "#/$defs/sha"},
    "trust_enrollment_id": {"$ref": "#/$defs/id"},
    "trust_enrollment_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_enrollment_policy_id": {"$ref": "#/$defs/id"},
    "trust_enrollment_policy_sha256": {"$ref": "#/$defs/sha"},
    "trust_enrollment_ssh_keygen_sha256": {"$ref": "#/$defs/sha"},
    "trust_enrollment_ledger_instance_id": {"$ref": "#/$defs/id"},
    "trust_enrollment_ledger_path_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_enrollment_minimum_policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "trust_enrollment_not_before": {"$ref": "#/$defs/timestamp"},
    "trust_enrollment_expires_at": {"$ref": "#/$defs/timestamp"},
    "domain": {"const": "champions-sim.production-trust-attestation.v1"},
    "attestation_id": {"$ref": "#/$defs/id"},
    "attestation_hash": {"$ref": "#/$defs/sha"},
    "subject_hash": {"$ref": "#/$defs/sha"},
    "policy_id": {"$ref": "#/$defs/id"},
    "policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "policy_sha256": {"$ref": "#/$defs/sha"},
    "issuer_id": {"$ref": "#/$defs/id"},
    "key_id": {"$ref": "#/$defs/id"},
    "key_fingerprint_sha256": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
    "algorithm": {"const": "ssh-ed25519"},
    "namespace": {"const": "champions-sim-production-trust-v1"},
    "ledger_binding_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  }
}
