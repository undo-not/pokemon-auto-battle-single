{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:target-pool-manifest:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "regulation_id", "regulation_revision", "regulation_hash", "eligible_pool_id", "eligible_pool_hash", "catalog_id", "catalog_hash", "ruleset_id", "ruleset_hash", "construction_corpus_id", "construction_corpus_hash", "mapping_set_id", "mapping_set_hash", "selection_policy", "eligible_member_count", "required_mechanics", "member_mappings", "included_records", "duplicate_aliases", "source_manifest_ids", "restricted_source_manifest_ids", "blockers"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "manifest_id": {"$ref": "#/$defs/id"}, "regulation_id": {"$ref": "#/$defs/id"}, "regulation_revision": {"$ref": "#/$defs/id"}, "regulation_hash": {"$ref": "#/$defs/sha"}, "eligible_pool_id": {"$ref": "#/$defs/id"}, "eligible_pool_hash": {"$ref": "#/$defs/sha"}, "catalog_id": {"$ref": "#/$defs/id"}, "catalog_hash": {"$ref": "#/$defs/sha"}, "ruleset_id": {"$ref": "#/$defs/id"}, "ruleset_hash": {"$ref": "#/$defs/sha"}, "construction_corpus_id": {"$ref": "#/$defs/id"}, "construction_corpus_hash": {"$ref": "#/$defs/sha"}, "mapping_set_id": {"$ref": "#/$defs/id"}, "mapping_set_hash": {"$ref": "#/$defs/sha"},
    "selection_policy": {"$ref": "#/$defs/policy"}, "eligible_member_count": {"type": "integer", "minimum": 1}, "required_mechanics": {"$ref": "#/$defs/ids"},
    "member_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
    "included_records": {"type": "array", "items": {"$ref": "#/$defs/recordIdentity"}},
    "duplicate_aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
    "source_manifest_ids": {"$ref": "#/$defs/ids"}, "restricted_source_manifest_ids": {"$ref": "#/$defs/ids"},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"}, "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {"type": "object", "additionalProperties": false, "required": ["eligible_member_policy", "construction_record_policy", "popularity_filter", "rank_filter", "minimum_usage_filter", "dedupe_policy"], "properties": {"eligible_member_policy": {"const": "all_official_records"}, "construction_record_policy": {"const": "all_sealed_records"}, "popularity_filter": {"const": "none"}, "rank_filter": {"const": "none"}, "minimum_usage_filter": {"const": "none"}, "dedupe_policy": {"const": "exact_record_hash_only"}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["target_key", "catalog_pokemon_id", "resolution_status", "verification_status", "mapping_method", "candidate_pokemon_ids", "evidence_ref_ids"], "properties": {"target_key": {"$ref": "#/$defs/id"}, "catalog_pokemon_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "resolution_status": {"enum": ["resolved", "unresolved", "conflict"]}, "verification_status": {"enum": ["verified", "partially_verified", "unverified"]}, "mapping_method": {"$ref": "#/$defs/id"}, "candidate_pokemon_ids": {"$ref": "#/$defs/ids"}, "evidence_ref_ids": {"$ref": "#/$defs/ids"}}},
    "recordIdentity": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_hash"], "properties": {"record_id": {"$ref": "#/$defs/id"}, "record_hash": {"$ref": "#/$defs/sha"}}},
    "alias": {"type": "object", "additionalProperties": false, "required": ["canonical_record_id", "duplicate_record_id", "identical_record_hash"], "properties": {"canonical_record_id": {"$ref": "#/$defs/id"}, "duplicate_record_id": {"$ref": "#/$defs/id"}, "identical_record_hash": {"$ref": "#/$defs/sha"}}}
  }
}
