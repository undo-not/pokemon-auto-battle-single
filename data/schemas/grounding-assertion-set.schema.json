{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:grounding-assertion-set:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "assertion_set_id", "target_capability_set_id", "target_capability_set_hash", "assertions", "source_manifest_ids"],
  "properties": {"schema_version": {"const": "1.0.0"}, "assertion_set_id": {"$ref": "#/$defs/id"}, "target_capability_set_id": {"$ref": "#/$defs/id"}, "target_capability_set_hash": {"$ref": "#/$defs/sha"}, "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}, "source_manifest_ids": {"$ref": "#/$defs/ids"}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"}, "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nullableSha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "nullableId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "stateCheck": {"type": "object", "additionalProperties": false, "required": ["path", "expected"], "properties": {"path": {"type": "string", "pattern": "^/"}, "expected": {}}},
    "checkRef": {"type": "object", "additionalProperties": false, "required": ["frame_id", "path"], "properties": {"frame_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^/"}}},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["assertion_id", "requirement_ids", "capability_ids", "evidence_kind", "ruleset_id", "ruleset_hash", "catalog_hash", "trace_id", "trace_hash", "reference_replay_hash", "initial_state_hash", "choice_sequence_hash", "rng_condition_id", "expected_event_slice_hash", "expected_state_checks", "conformance_check_refs", "evidence_ref_ids", "claimed_verdict"], "properties": {"assertion_id": {"$ref": "#/$defs/id"}, "requirement_ids": {"$ref": "#/$defs/ids"}, "capability_ids": {"$ref": "#/$defs/ids"}, "evidence_kind": {"enum": ["actual_bluestacks", "official_primary", "published_reference"]}, "ruleset_id": {"$ref": "#/$defs/id"}, "ruleset_hash": {"$ref": "#/$defs/sha"}, "catalog_hash": {"$ref": "#/$defs/sha"}, "trace_id": {"$ref": "#/$defs/nullableId"}, "trace_hash": {"$ref": "#/$defs/nullableSha"}, "reference_replay_hash": {"$ref": "#/$defs/nullableSha"}, "initial_state_hash": {"$ref": "#/$defs/sha"}, "choice_sequence_hash": {"$ref": "#/$defs/sha"}, "rng_condition_id": {"$ref": "#/$defs/id"}, "expected_event_slice_hash": {"$ref": "#/$defs/nullableSha"}, "expected_state_checks": {"type": "array", "items": {"$ref": "#/$defs/stateCheck"}}, "conformance_check_refs": {"type": "array", "items": {"$ref": "#/$defs/checkRef"}}, "evidence_ref_ids": {"$ref": "#/$defs/ids"}, "claimed_verdict": {"enum": ["pass", "fail", "unknown"]}}}
  }
}
