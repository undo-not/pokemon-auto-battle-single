{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-source-policy-register-v1",
  "title": "SIM-02C-A Source Policy Register V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "reviewed_on",
    "authorization_status",
    "policies",
    "registry_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"$ref": "#/$defs/stableId"},
    "reviewed_on": {"$ref": "#/$defs/isoDateOrTimestamp"},
    "authorization_status": {"const": "not_authorization"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/policy"}
    },
    "registry_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "isoDateOrTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]+)?)?(?:Z|[+-][0-9]{2}:[0-9]{2}))?$"
    },
    "evidenceUrl": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "source_ids",
        "source_group",
        "review_status",
        "evidence_urls",
        "decision_basis",
        "collection_status",
        "candidate_use",
        "private_match_use",
        "training_use",
        "redistribution",
        "production_promotion",
        "notes"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/stableId"},
        "source_ids": {
          "type": "array",
          "description": "Source identifiers must be serialized in ascending lexicographic order and must be unique.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "source_group": {"$ref": "#/$defs/stableId"},
        "review_status": {
          "enum": ["approved", "review_required", "rejected"]
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceUrl"}
        },
        "decision_basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "collection_status": {
          "enum": ["allowed", "manual_reference_only", "disabled_pending_review"]
        },
        "candidate_use": {
          "enum": ["allowed", "restricted_local", "prohibited"]
        },
        "private_match_use": {
          "enum": ["allowed", "review_required", "prohibited"]
        },
        "training_use": {
          "enum": ["allowed", "review_required", "prohibited"]
        },
        "redistribution": {"enum": ["allowed", "prohibited"]},
        "production_promotion": {"enum": ["allowed", "blocked"]},
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
