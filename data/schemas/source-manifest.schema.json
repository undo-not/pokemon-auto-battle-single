{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:source-manifest:1",
  "title": "ChampionSim Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "source_kind",
    "title",
    "publisher",
    "locator",
    "retrieved_on",
    "license_status",
    "license",
    "usage_policy",
    "artifacts",
    "scope",
    "processing",
    "trust",
    "derivation_status",
    "parent_manifest_ids",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "$ref": "#/$defs/stableId"
    },
    "source_kind": {
      "enum": [
        "official_rule",
        "official_catalog",
        "primary_reference",
        "secondary_reference",
        "paper",
        "dataset",
        "user_observation",
        "legacy_project"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["url", "doi", "local_path", "logical"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retrieved_on": {
      "type": "string",
      "format": "date"
    },
    "license_status": {
      "$ref": "#/$defs/licenseStatus"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "url",
        "redistribution_allowed",
        "commercial_use_allowed",
        "notes"
      ],
      "properties": {
        "identifier": {
          "type": ["string", "null"]
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "redistribution_allowed": {
          "type": ["boolean", "null"]
        },
        "commercial_use_allowed": {
          "type": ["boolean", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "usage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_research_only", "redistribution", "derivative_distribution"],
      "properties": {
        "local_research_only": {
          "type": "boolean"
        },
        "redistribution": {
          "enum": ["allowed", "prohibited"]
        },
        "derivative_distribution": {
          "enum": ["allowed", "prohibited", "review_required"]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regulation_ids", "entity_types", "language"],
      "properties": {
        "regulation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "entity_types": {
          "type": "array",
          "items": {
            "enum": [
              "ruleset",
              "pokemon",
              "move",
              "ability",
              "item",
              "type_chart",
              "mechanics",
              "usage",
              "battle_replay",
              "article",
              "code"
            ]
          },
          "uniqueItems": true
        },
        "language": {
          "type": ["string", "null"],
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_method", "parser_version", "normalized_artifact_ids"],
      "properties": {
        "retrieval_method": {
          "enum": ["manual_reference", "manual_download", "http_fetch", "api", "screen_observation", "generated"]
        },
        "parser_version": {
          "type": ["string", "null"]
        },
        "normalized_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "verification_status"],
      "properties": {
        "authority": {
          "enum": ["official", "primary", "secondary", "community", "local_unknown"]
        },
        "verification_status": {
          "enum": ["verified", "partially_verified", "unverified", "example_only"]
        }
      }
    },
    "derivation_status": {
      "enum": ["reference_only", "raw", "normalized", "derived", "summary"]
    },
    "parent_manifest_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "license_status": {
            "const": "unverified"
          }
        },
        "required": ["license_status"]
      },
      "then": {
        "properties": {
          "license": {
            "properties": {
              "redistribution_allowed": {
                "const": false
              },
              "commercial_use_allowed": {
                "const": false
              }
            }
          },
          "usage_policy": {
            "properties": {
              "local_research_only": {
                "const": true
              },
              "redistribution": {
                "const": "prohibited"
              },
              "derivative_distribution": {
                "enum": ["prohibited", "review_required"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "licenseStatus": {
      "enum": ["verified", "unverified", "not_applicable"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "logical_path",
        "media_type",
        "byte_size",
        "sha256",
        "record_count"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stableId"
        },
        "logical_path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record_count": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
