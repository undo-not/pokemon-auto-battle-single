{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:replay:2",
  "title": "ChampionSim Deterministic Replay v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replay_id",
    "bundle",
    "rng_algorithm_id",
    "initial_rng",
    "rng_after_initialization",
    "final_rng",
    "initial_state",
    "initial_events",
    "initialized_state_hash",
    "steps",
    "result",
    "final_state_hash",
    "visibility",
    "provisional_decision_ids",
    "source_manifest_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "replay_id": {
      "$ref": "#/$defs/stableId"
    },
    "bundle": {
      "$ref": "#/$defs/bundle"
    },
    "rng_algorithm_id": {
      "const": "splitmix64-v1"
    },
    "initial_rng": {
      "$ref": "#/$defs/rng"
    },
    "rng_after_initialization": {
      "$ref": "#/$defs/rng"
    },
    "final_rng": {
      "$ref": "#/$defs/rng"
    },
    "initial_state": {
      "$ref": "#/$defs/initialState"
    },
    "initial_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "initialized_state_hash": {
      "$ref": "#/$defs/sha256"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "final_state_hash": {
      "$ref": "#/$defs/sha256"
    },
    "visibility": {
      "$ref": "#/$defs/visibility"
    },
    "provisional_decision_ids": {
      "$ref": "#/$defs/provisionalDecisionIds"
    },
    "source_manifest_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provisionalDecisionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PD-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulator_version",
        "engine_semantics_version",
        "ruleset_id",
        "ruleset_content_hash",
        "catalog_id",
        "catalog_content_hash"
      ],
      "properties": {
        "simulator_version": {
          "type": "string",
          "minLength": 1
        },
        "engine_semantics_version": {
          "$ref": "#/$defs/stableId"
        },
        "ruleset_id": {
          "$ref": "#/$defs/stableId"
        },
        "ruleset_content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_id": {
          "$ref": "#/$defs/stableId"
        },
        "catalog_content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "state", "cursor"],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "payload", "state_hash"],
      "properties": {
        "encoding": {
          "const": "champions_sim.battle_state.v1"
        },
        "payload": {
          "$ref": "#/$defs/battleState"
        },
        "state_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "battleState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battle_id",
        "ruleset_id",
        "turn",
        "phase",
        "sides",
        "field_conditions",
        "winner"
      ],
      "properties": {
        "battle_id": {
          "$ref": "#/$defs/stableId"
        },
        "ruleset_id": {
          "$ref": "#/$defs/stableId"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "team_preview",
            "awaiting_decisions",
            "resolving",
            "forced_switch",
            "finished"
          ]
        },
        "sides": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/side"
          }
        },
        "field_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "winner": {
          "$ref": "#/$defs/nullablePlayer"
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player", "team", "active_instance_id"],
      "properties": {
        "player": {
          "$ref": "#/$defs/player"
        },
        "team": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pokemon"
          }
        },
        "active_instance_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "pokemon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "pokemon_id",
        "level",
        "hp",
        "stats",
        "types",
        "moves",
        "item_id",
        "consumed_item_id",
        "ability_id",
        "status_id",
        "stat_stages",
        "volatile_statuses",
        "revealed_to_opponent",
        "item_revealed_to_opponent",
        "ability_revealed_to_opponent"
      ],
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/stableId"
        },
        "pokemon_id": {
          "$ref": "#/$defs/stableId"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "hp": {
          "type": "integer",
          "minimum": 0
        },
        "stats": {
          "$ref": "#/$defs/stats"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "moves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moveSlot"
          }
        },
        "item_id": {
          "$ref": "#/$defs/nullableStableId"
        },
        "consumed_item_id": {
          "$ref": "#/$defs/nullableStableId"
        },
        "ability_id": {
          "$ref": "#/$defs/nullableStableId"
        },
        "status_id": {
          "$ref": "#/$defs/nullableStableId"
        },
        "stat_stages": {
          "$ref": "#/$defs/statStages"
        },
        "volatile_statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "revealed_to_opponent": {
          "type": "boolean"
        },
        "item_revealed_to_opponent": {
          "type": "boolean"
        },
        "ability_revealed_to_opponent": {
          "type": "boolean"
        },
        "mega_evolved": {
          "type": "boolean"
        },
        "mega_evolution_profile": {
          "$ref": "#/$defs/megaEvolutionProfile"
        }
      }
    },
    "megaEvolutionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_pokemon_id",
        "stats",
        "level",
        "ivs",
        "evs",
        "nature_increased_stat",
        "nature_decreased_stat",
        "derivation_method_id",
        "source_manifest_id",
        "source_record_id",
        "profile_hash"
      ],
      "properties": {
        "target_pokemon_id": {"$ref": "#/$defs/stableId"},
        "stats": {"$ref": "#/$defs/stats"},
        "level": {"type": "integer", "minimum": 1, "maximum": 100},
        "ivs": {"$ref": "#/$defs/ivTrainingStats"},
        "evs": {"$ref": "#/$defs/evTrainingStats"},
        "nature_increased_stat": {"$ref": "#/$defs/nullableNatureStat"},
        "nature_decreased_stat": {"$ref": "#/$defs/nullableNatureStat"},
        "derivation_method_id": {"const": "pokemon-mainline-stat-v1"},
        "source_manifest_id": {"$ref": "#/$defs/stableId"},
        "source_record_id": {"$ref": "#/$defs/stableId"},
        "profile_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableNatureStat": {
      "type": ["string", "null"],
      "enum": [null, "attack", "defense", "special_attack", "special_defense", "speed"]
    },
    "ivTrainingStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "attack", "defense", "special_attack", "special_defense", "speed"],
      "properties": {
        "hp": {"type": "integer", "minimum": 0, "maximum": 31},
        "attack": {"type": "integer", "minimum": 0, "maximum": 31},
        "defense": {"type": "integer", "minimum": 0, "maximum": 31},
        "special_attack": {"type": "integer", "minimum": 0, "maximum": 31},
        "special_defense": {"type": "integer", "minimum": 0, "maximum": 31},
        "speed": {"type": "integer", "minimum": 0, "maximum": 31}
      }
    },
    "evTrainingStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "attack", "defense", "special_attack", "special_defense", "speed"],
      "properties": {
        "hp": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "attack": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "defense": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "special_attack": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "special_defense": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "speed": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4}
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_hp", "attack", "defense", "special_attack", "special_defense", "speed"],
      "properties": {
        "max_hp": {
          "type": "integer",
          "minimum": 1
        },
        "attack": {
          "type": "integer",
          "minimum": 1
        },
        "defense": {
          "type": "integer",
          "minimum": 1
        },
        "special_attack": {
          "type": "integer",
          "minimum": 1
        },
        "special_defense": {
          "type": "integer",
          "minimum": 1
        },
        "speed": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "statStages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "defense", "special_attack", "special_defense", "speed", "accuracy", "evasion"],
      "properties": {
        "attack": {
          "$ref": "#/$defs/stage"
        },
        "defense": {
          "$ref": "#/$defs/stage"
        },
        "special_attack": {
          "$ref": "#/$defs/stage"
        },
        "special_defense": {
          "$ref": "#/$defs/stage"
        },
        "speed": {
          "$ref": "#/$defs/stage"
        },
        "accuracy": {
          "$ref": "#/$defs/stage"
        },
        "evasion": {
          "$ref": "#/$defs/stage"
        }
      }
    },
    "stage": {
      "type": "integer",
      "minimum": -6,
      "maximum": 6
    },
    "moveSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["move_id", "pp", "max_pp", "revealed_to_opponent"],
      "properties": {
        "move_id": {
          "$ref": "#/$defs/stableId"
        },
        "pp": {
          "type": "integer",
          "minimum": 0
        },
        "max_pp": {
          "type": "integer",
          "minimum": 1
        },
        "revealed_to_opponent": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "selections",
        "rng_before",
        "rng_after",
        "events",
        "result_state_hash",
        "terminal",
        "provisional_decision_ids"
      ],
      "properties": {
        "requests": {
          "$ref": "#/$defs/requestSet"
        },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/selection"
          }
        },
        "rng_before": {
          "$ref": "#/$defs/rng"
        },
        "rng_after": {
          "$ref": "#/$defs/rng"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "result_state_hash": {
          "$ref": "#/$defs/sha256"
        },
        "terminal": {
          "type": "boolean"
        },
        "provisional_decision_ids": {
          "$ref": "#/$defs/provisionalDecisionIds"
        }
      }
    },
    "requestSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests"],
      "properties": {
        "requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/request"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "player", "kind", "legal_actions"],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stableId"
        },
        "player": {
          "$ref": "#/$defs/player"
        },
        "kind": {
          "enum": ["action", "forced_switch"]
        },
        "legal_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/legalAction"
          }
        }
      }
    },
    "legalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "move_id", "switch_to"],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": ["move", "switch", "pass", "forfeit"]
        },
        "move_id": {
          "$ref": "#/$defs/nullableStableId"
        },
        "switch_to": {
          "$ref": "#/$defs/nullableStableId"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "player", "action_id"],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/stableId"
        },
        "player": {
          "$ref": "#/$defs/player"
        },
        "action_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "actor", "subject", "details"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "battle_started",
            "turn_started",
            "action_ordered",
            "move_used",
            "move_missed",
            "action_failed",
            "critical_hit",
            "switched",
            "damage",
            "healed",
            "stat_stage_changed",
            "status_changed",
            "volatile_changed",
            "ability_triggered",
            "item_triggered",
            "item_consumed",
            "mega_evolved",
            "pp_changed",
            "fainted",
            "revealed",
            "rng_draw",
            "turn_ended",
            "battle_ended"
          ]
        },
        "actor": {
          "$ref": "#/$defs/nullablePlayer"
        },
        "subject": {
          "$ref": "#/$defs/nullableStableId"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/stableId"
              },
              {
                "type": ["string", "integer", "boolean", "null"]
              }
            ],
            "items": false
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "winner", "reason"],
      "properties": {
        "outcome": {
          "enum": ["player_win", "draw", "aborted", "unsupported"]
        },
        "winner": {
          "$ref": "#/$defs/nullablePlayer"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_private_state", "redaction"],
      "properties": {
        "contains_private_state": {
          "const": true
        },
        "redaction": {
          "const": "none"
        }
      }
    },
    "player": {
      "enum": ["p1", "p2"]
    },
    "nullablePlayer": {
      "enum": ["p1", "p2", null]
    },
    "nullableStableId": {
      "oneOf": [
        {
          "$ref": "#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
