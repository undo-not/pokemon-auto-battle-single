{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:production-catalog-input:1",
  "title": "Source-bound Production Catalog Compiler Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compiler_version", "input_id", "intake_bundle_hash",
    "regulation_id", "regulation_revision", "target_pool_hash", "target_key_hash",
    "runtime_catalog_hash", "target_member_count", "source_policy", "members",
    "records", "evidence_refs", "source_manifest_ids", "blockers",
    "denominator_final", "catalog_emit_eligible", "input_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "compiler_version": {"const": "1.0.0"},
    "input_id": {"$ref": "#/$defs/id"},
    "intake_bundle_hash": {"$ref": "#/$defs/sha"},
    "regulation_id": {"$ref": "#/$defs/id"},
    "regulation_revision": {"$ref": "#/$defs/id"},
    "target_pool_hash": {"$ref": "#/$defs/sha"},
    "target_key_hash": {"$ref": "#/$defs/sha"},
    "runtime_catalog_hash": {"$ref": "#/$defs/sha"},
    "target_member_count": {"type": "integer", "minimum": 1},
    "source_policy": {"$ref": "#/$defs/policy"},
    "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "source_manifest_ids": {"$ref": "#/$defs/ids"},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "denominator_final": {"const": false},
    "catalog_emit_eligible": {"const": false},
    "input_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["license_status", "access_scope", "redistribution", "payload_policy"],
      "properties": {
        "license_status": {"const": "unverified"},
        "access_scope": {"const": "local_only"},
        "redistribution": {"const": "prohibited"},
        "payload_policy": {"const": "reference_only_no_raw_effect_text"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_ref_id", "source_manifest_id", "artifact_id", "json_pointer", "record_sha256"],
      "properties": {
        "evidence_ref_id": {"$ref": "#/$defs/id"},
        "source_manifest_id": {"$ref": "#/$defs/id"},
        "artifact_id": {"$ref": "#/$defs/id"},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "record_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": [
        "target_key", "catalog_pokemon_id", "candidate_pokemon_ids",
        "resolution_status", "verification_status", "mapping_method",
        "mapping_evidence_ref_ids", "detail_evidence_ref_id"
      ],
      "properties": {
        "target_key": {"$ref": "#/$defs/id"},
        "catalog_pokemon_id": {"type": "null"},
        "candidate_pokemon_ids": {"$ref": "#/$defs/ids"},
        "resolution_status": {"enum": ["unresolved", "conflict"]},
        "verification_status": {"const": "unverified"},
        "mapping_method": {"$ref": "#/$defs/id"},
        "mapping_evidence_ref_ids": {"$ref": "#/$defs/ids"},
        "detail_evidence_ref_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_kind", "entity_id", "record_status", "verification_status", "source_ref"],
      "properties": {
        "entity_kind": {"enum": ["pokemon", "mega_pokemon", "move", "ability", "item", "type"]},
        "entity_id": {"$ref": "#/$defs/id"},
        "record_status": {"enum": ["source_bound", "missing"]},
        "verification_status": {"const": "unverified"},
        "source_ref": {"oneOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]}
      }
    }
  }
}
