{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-production-trust-attestation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["statement", "signature"],
  "properties": {
    "statement": {"$ref": "#/$defs/statement"},
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 32768,
      "pattern": "^-----BEGIN SSH SIGNATURE-----\\n(?:[A-Za-z0-9+/=]+\\n)+-----END SSH SIGNATURE-----\\n$"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "project_id",
        "purpose",
        "environment",
        "compiler_contract_version",
        "attestation_scope",
        "regulation_id",
        "regulation_revision",
        "regulation_hash",
        "target_pool_id",
        "target_pool_hash",
        "source_authority_subject_hash",
        "request_binding_hash",
        "replay_binding_hash"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "domain": {"const": "champions-sim.production-trust-attestation.v1"},
        "project_id": {"const": "champions_sim"},
        "purpose": {"const": "production_source_approval"},
        "environment": {"const": "private_match"},
        "compiler_contract_version": {"$ref": "#/$defs/stableId"},
        "attestation_scope": {"const": "production_champions"},
        "regulation_id": {"$ref": "#/$defs/stableId"},
        "regulation_revision": {"$ref": "#/$defs/stableId"},
        "regulation_hash": {"$ref": "#/$defs/sha256"},
        "target_pool_id": {"$ref": "#/$defs/stableId"},
        "target_pool_hash": {"$ref": "#/$defs/sha256"},
        "source_authority_subject_hash": {"$ref": "#/$defs/sha256"},
        "request_binding_hash": {"$ref": "#/$defs/sha256"},
        "replay_binding_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "canonicalization",
        "domain",
        "attestation_id",
        "issuer_id",
        "key_id",
        "algorithm",
        "namespace",
        "issued_at",
        "not_before",
        "expires_at",
        "policy_id",
        "policy_epoch",
        "subject",
        "subject_hash"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "canonicalization": {"const": "champions-canonical-json-v1"},
        "domain": {"const": "champions-sim.production-trust-attestation.v1"},
        "attestation_id": {"$ref": "#/$defs/stableId"},
        "issuer_id": {"$ref": "#/$defs/stableId"},
        "key_id": {"$ref": "#/$defs/stableId"},
        "algorithm": {"const": "ssh-ed25519"},
        "namespace": {"const": "champions-sim-production-trust-v1"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "not_before": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "policy_id": {"$ref": "#/$defs/stableId"},
        "policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "subject": {"$ref": "#/$defs/subject"},
        "subject_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
