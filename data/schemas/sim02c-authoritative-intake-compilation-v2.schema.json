{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-authoritative-intake-compilation-v2",
  "title": "SIM-02C-A Authoritative Intake Compilation V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "compilation_id",
    "plan_id",
    "plan_hash",
    "policy_registry_id",
    "policy_registry_hash",
    "source_lock_hash",
    "regulation_id",
    "regulation_revision",
    "target_source_manifest_ids",
    "target_source_manifest_hash",
    "target_pool_hash",
    "authorization_status",
    "production_materialization_emitted",
    "document_digests",
    "source_summary",
    "mapping_summary",
    "catalog_summary",
    "assessment_summary",
    "compilation_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "compiler_version": {"const": "2.0.0"},
    "compilation_id": {
      "type": "string",
      "pattern": "^authoritative-intake:[0-9a-f]{24}$"
    },
    "plan_id": {"$ref": "#/$defs/stableId"},
    "plan_hash": {"$ref": "#/$defs/sha256"},
    "policy_registry_id": {"$ref": "#/$defs/stableId"},
    "policy_registry_hash": {"$ref": "#/$defs/sha256"},
    "source_lock_hash": {"$ref": "#/$defs/sha256"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "regulation_revision": {"type": "string", "minLength": 1},
    "target_source_manifest_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "target_source_manifest_hash": {"$ref": "#/$defs/sha256"},
    "target_pool_hash": {"$ref": "#/$defs/sha256"},
    "authorization_status": {"const": "not_authorization"},
    "production_materialization_emitted": {"const": false},
    "document_digests": {"$ref": "#/$defs/documentDigests"},
    "source_summary": {"$ref": "#/$defs/sourceSummary"},
    "mapping_summary": {"$ref": "#/$defs/mappingSummary"},
    "catalog_summary": {"$ref": "#/$defs/catalogSummary"},
    "assessment_summary": {"$ref": "#/$defs/assessmentSummary"},
    "compilation_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "documentDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source-acquisition-review.json",
        "authoritative-mapping-workbench.json",
        "authoritative-catalog-v2-workbench.json",
        "authoritative-intake-assessment.json"
      ],
      "properties": {
        "source-acquisition-review.json": {"$ref": "#/$defs/sha256"},
        "authoritative-mapping-workbench.json": {"$ref": "#/$defs/sha256"},
        "authoritative-catalog-v2-workbench.json": {"$ref": "#/$defs/sha256"},
        "authoritative-intake-assessment.json": {"$ref": "#/$defs/sha256"}
      }
    },
    "acquisitionIntegrityCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reproduced": {"const": 0},
        "snapshot_bound": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0}
      }
    },
    "policyReviewStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": {"type": "integer", "minimum": 0},
        "review_required": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "sourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_count",
        "acquisition_integrity_counts",
        "policy_review_status_counts",
        "policy_resolved_for_production_route_count",
        "acquisition_route_integrity_rate_ppm",
        "snapshot_bound_route_rate_ppm",
        "source_policy_resolution_rate_ppm",
        "production_promotable_route_count",
        "raw_file_count",
        "raw_byte_count",
        "derived_artifact_count",
        "blocker_count"
      ],
      "properties": {
        "route_count": {"type": "integer", "minimum": 1},
        "acquisition_integrity_counts": {
          "$ref": "#/$defs/acquisitionIntegrityCounts"
        },
        "policy_review_status_counts": {
          "$ref": "#/$defs/policyReviewStatusCounts"
        },
        "policy_resolved_for_production_route_count": {
          "type": "integer",
          "minimum": 0
        },
        "acquisition_route_integrity_rate_ppm": {"const": 0},
        "snapshot_bound_route_rate_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "source_policy_resolution_rate_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "production_promotable_route_count": {"const": 0},
        "raw_file_count": {"type": "integer", "minimum": 0},
        "raw_byte_count": {"type": "integer", "minimum": 0},
        "derived_artifact_count": {"type": "integer", "minimum": 0},
        "blocker_count": {"type": "integer", "minimum": 0}
      }
    },
    "mappingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_member_count",
        "candidate_count",
        "conflict_count",
        "unresolved_count",
        "verified_count",
        "promotion_unresolved_count",
        "reviewed_mapping_count",
        "namespace_form_complete_count",
        "authoritative_mapping_rate_ppm"
      ],
      "properties": {
        "target_member_count": {"type": "integer", "minimum": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"type": "integer", "minimum": 0},
        "verified_count": {"const": 0},
        "promotion_unresolved_count": {"type": "integer", "minimum": 0},
        "reviewed_mapping_count": {"const": 0},
        "namespace_form_complete_count": {"const": 0},
        "authoritative_mapping_rate_ppm": {"const": 0}
      }
    },
    "fieldStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_unreviewed": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "unknown_semantics": {"type": "integer", "minimum": 0}
      }
    },
    "catalogSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species_count",
        "move_count",
        "ability_count",
        "item_count",
        "type_count",
        "mega_relation_candidate_count",
        "required_field_count",
        "field_status_counts",
        "verified_field_count",
        "catalog_required_field_evidence_rate_ppm",
        "runtime_lowerable_entity_count",
        "production_catalog_ready"
      ],
      "properties": {
        "species_count": {"type": "integer", "minimum": 1},
        "move_count": {"type": "integer", "minimum": 0},
        "ability_count": {"type": "integer", "minimum": 0},
        "item_count": {"type": "integer", "minimum": 0},
        "type_count": {"type": "integer", "minimum": 0},
        "mega_relation_candidate_count": {"type": "integer", "minimum": 0},
        "required_field_count": {"type": "integer", "minimum": 0},
        "field_status_counts": {"$ref": "#/$defs/fieldStatusCounts"},
        "verified_field_count": {"const": 0},
        "catalog_required_field_evidence_rate_ppm": {"const": 0},
        "runtime_lowerable_entity_count": {"const": 0},
        "production_catalog_ready": {"const": false}
      }
    },
    "stageBlockerCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquisition": {"type": "integer", "minimum": 0},
        "policy": {"type": "integer", "minimum": 0},
        "mapping": {"type": "integer", "minimum": 0},
        "catalog": {"type": "integer", "minimum": 0},
        "mechanics": {"type": "integer", "minimum": 0},
        "scenario": {"type": "integer", "minimum": 0},
        "grounding": {"type": "integer", "minimum": 0},
        "holdout": {"type": "integer", "minimum": 0},
        "trust": {"type": "integer", "minimum": 0},
        "rehearsal": {"type": "integer", "minimum": 0}
      }
    },
    "codeBlockerCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_evidence_file_missing": {"type": "integer", "minimum": 0},
        "source_id_mismatch": {"type": "integer", "minimum": 0},
        "source_evidence_coverage_incomplete": {"type": "integer", "minimum": 0},
        "raw_manifest_source_missing": {"type": "integer", "minimum": 0},
        "raw_manifest_results_empty": {"type": "integer", "minimum": 0},
        "raw_manifest_results_missing": {"type": "integer", "minimum": 0},
        "raw_manifest_result_invalid": {"type": "integer", "minimum": 0},
        "raw_manifest_saved_path_missing": {"type": "integer", "minimum": 0},
        "raw_manifest_saved_file_missing": {"type": "integer", "minimum": 0},
        "raw_manifest_byte_count_mismatch": {"type": "integer", "minimum": 0},
        "raw_manifest_result_unsealed": {"type": "integer", "minimum": 0},
        "raw_manifest_hash_mismatch": {"type": "integer", "minimum": 0},
        "raw_manifest_duplicate_saved_path": {"type": "integer", "minimum": 0},
        "raw_manifest_inventory_binding_invalid": {"type": "integer", "minimum": 0},
        "raw_manifest_inventory_binding_missing": {"type": "integer", "minimum": 0},
        "raw_manifest_inventory_directory_missing": {"type": "integer", "minimum": 0},
        "raw_manifest_payload_outside_inventory": {"type": "integer", "minimum": 0},
        "raw_inventory_contains_unmanifested_payload": {"type": "integer", "minimum": 0},
        "raw_inventory_manifest_binding_ambiguous": {"type": "integer", "minimum": 0},
        "raw_inventory_manifest_binding_missing": {"type": "integer", "minimum": 0},
        "raw_inventory_missing": {"type": "integer", "minimum": 0},
        "raw_inventory_too_small": {"type": "integer", "minimum": 0},
        "derived_artifact_missing": {"type": "integer", "minimum": 0},
        "derived_source_mismatch": {"type": "integer", "minimum": 0},
        "derived_record_pointer_invalid": {"type": "integer", "minimum": 0},
        "derived_record_count_too_small": {"type": "integer", "minimum": 0},
        "derived_lineage_requirements_missing": {"type": "integer", "minimum": 0},
        "derived_lineage_graph_unrepresentable": {"type": "integer", "minimum": 0},
        "derived_lineage_invalid": {"type": "integer", "minimum": 0},
        "source_policy_review_unresolved": {"type": "integer", "minimum": 0},
        "source_policy_binding_mismatch": {"type": "integer", "minimum": 0},
        "source_collection_not_approved": {"type": "integer", "minimum": 0},
        "source_candidate_use_restricted": {"type": "integer", "minimum": 0},
        "source_private_match_use_not_allowed": {"type": "integer", "minimum": 0},
        "source_training_use_not_allowed": {"type": "integer", "minimum": 0},
        "source_redistribution_prohibited": {"type": "integer", "minimum": 0},
        "source_production_promotion_blocked": {"type": "integer", "minimum": 0},
        "authoritative_mapping_missing": {"type": "integer", "minimum": 0},
        "candidate_mapping_conflict": {"type": "integer", "minimum": 0},
        "candidate_mapping_unreviewed": {"type": "integer", "minimum": 0},
        "namespace_form_identity_incomplete": {"type": "integer", "minimum": 0},
        "mapping_permission_unresolved": {"type": "integer", "minimum": 0},
        "target_denominator_authority_unresolved": {"type": "integer", "minimum": 0},
        "catalog_field_missing": {"type": "integer", "minimum": 0},
        "catalog_field_unknown_semantics": {"type": "integer", "minimum": 0},
        "catalog_field_conflict": {"type": "integer", "minimum": 0},
        "catalog_field_unverified": {"type": "integer", "minimum": 0},
        "runtime_handler_coverage_incomplete": {"type": "integer", "minimum": 0},
        "scenario_coverage_incomplete": {"type": "integer", "minimum": 0},
        "private_match_grounding_missing": {"type": "integer", "minimum": 0},
        "external_holdout_missing": {"type": "integer", "minimum": 0},
        "production_attestation_missing": {"type": "integer", "minimum": 0},
        "regulation_rehearsal_missing": {"type": "integer", "minimum": 0}
      }
    },
    "assessmentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "candidate_for_production_promotion",
        "fixed_target_denominator",
        "verified_mapping_count",
        "verified_catalog_field_count",
        "blocker_enumeration_scope",
        "blocker_enumeration_complete",
        "assessment_blocker_enumeration_rate_ppm",
        "undeclared_dependency_enumeration_complete",
        "blocker_count",
        "stage_blocker_counts",
        "code_blocker_counts"
      ],
      "properties": {
        "decision": {"const": "NO-GO"},
        "candidate_for_production_promotion": {"const": false},
        "fixed_target_denominator": {"type": "integer", "minimum": 1},
        "verified_mapping_count": {"const": 0},
        "verified_catalog_field_count": {"const": 0},
        "blocker_enumeration_scope": {
          "const": "declared_workbench_surfaces_and_known_gap_hints"
        },
        "blocker_enumeration_complete": {"const": true},
        "assessment_blocker_enumeration_rate_ppm": {"const": 1000000},
        "undeclared_dependency_enumeration_complete": {"const": false},
        "blocker_count": {"type": "integer", "minimum": 1},
        "stage_blocker_counts": {"$ref": "#/$defs/stageBlockerCounts"},
        "code_blocker_counts": {"$ref": "#/$defs/codeBlockerCounts"}
      }
    }
  }
}
