{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02b-promotion-source-manifest-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "source_kind",
    "authority",
    "title",
    "publisher",
    "locator",
    "retrieved_at",
    "license_artifact_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_id": {"$ref": "#/$defs/stableId"},
    "source_kind": {
      "enum": [
        "test_fixture",
        "official_rule",
        "official_catalog",
        "primary_reference"
      ]
    },
    "authority": {"enum": ["test_authoritative", "official", "primary"]},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["logical", "url", "doi"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "license_artifact_id": {"$ref": "#/$defs/stableId"},
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "relative_path",
        "media_type",
        "byte_count",
        "sha256"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "role": {"enum": ["license_record", "source_data"]},
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:][^\\\\:]*$"
        },
        "media_type": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
