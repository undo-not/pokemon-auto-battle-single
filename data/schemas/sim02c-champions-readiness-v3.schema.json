        "target_capability_set_hash": {"$ref": "#/$defs/sha"},
        "execution_compilation_hash": {"$ref": "#/$defs/sha"},
        "construction_corpus_hash": {"$ref": "#/$defs/sha"},
        "scenario_corpus_hash": {"$ref": "#/$defs/sha"},
        "external_holdout_scenario_corpus_hash": {"$ref": "#/$defs/sha"},
        "partition_manifest_hash": {"$ref": "#/$defs/sha"},
        "external_holdout_hash": {"$ref": "#/$defs/sha"},
        "grounding_resolution_hash": {"$ref": "#/$defs/sha"},
        "engine_probe_report_hash": {"$ref": "#/$defs/sha"},
        "mechanic_coverage_matrix_hash": {"$ref": "#/$defs/sha"},
        "timing_evidence_hash": {"$ref": "#/$defs/sha"}
      }
    }
  }
