    "input_content_hash": {"$ref": "#/$defs/sha"},
    "request_binding_hash": {"$ref": "#/$defs/sha"},
    "replay_binding_hash": {"$ref": "#/$defs/sha"},
    "source_authority_subject_hash": {"$ref": "#/$defs/sha"},
    "base_compilation_id": {"$ref": "#/$defs/id"},
    "base_compilation_hash": {"$ref": "#/$defs/sha"},
    "base_promotion_report_id": {"$ref": "#/$defs/id"},
    "base_promotion_report_hash": {"$ref": "#/$defs/sha"},
    "component_hashes": {"$ref": "#/$defs/components"},
    "v3_document_set_hash": {"$ref": "#/$defs/sha"},
    "trust_attestation_id": {"$ref": "#/$defs/id"},
    "trust_attestation_hash": {"$ref": "#/$defs/sha"},
    "trust_subject_hash": {"$ref": "#/$defs/sha"},
    "stable_trust_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_policy_id": {"$ref": "#/$defs/id"},
    "trust_policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "trust_policy_sha256": {"$ref": "#/$defs/sha"},
    "trust_issuer_id": {"$ref": "#/$defs/id"},
    "trust_key_id": {"$ref": "#/$defs/id"},
    "trust_key_fingerprint_sha256": {"$ref": "#/$defs/fingerprint"},
    "trust_ledger_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_registry_id": {"$ref": "#/$defs/id"},
    "trust_registry_sha256": {"$ref": "#/$defs/sha"},
    "trust_enrollment_id": {"$ref": "#/$defs/id"},
    "trust_enrollment_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_enrollment_minimum_policy_epoch": {"type": "integer", "minimum": 1},
    "trust_enrollment_ssh_keygen_sha256": {"$ref": "#/$defs/sha"},
    "trust_ledger_instance_id": {"$ref": "#/$defs/id"},
    "trust_ledger_path_binding_hash": {"$ref": "#/$defs/sha"},
    "compilation_binding_hash": {"$ref": "#/$defs/sha"},
    "seal_hash": {"$ref": "#/$defs/sha"}
  },
