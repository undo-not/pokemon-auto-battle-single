{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-authoritative-catalog-v2-workbench-v2",
  "title": "SIM-02C-A Authoritative Catalog V2 Workbench Contract V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "catalog_workbench_id",
    "plan_id",
    "regulation_id",
    "regulation_revision",
    "target_source_manifest_hash",
    "target_pool_hash",
    "source_review_hash",
    "mapping_workbench_hash",
    "authorization_status",
    "payload_policy",
    "types_inventory_hash",
    "species",
    "moves",
    "abilities",
    "items",
    "types",
    "mega_relations",
    "summary",
    "catalog_workbench_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0-workbench"},
    "compiler_version": {"const": "2.0.0"},
    "catalog_workbench_id": {
      "type": "string",
      "pattern": "^catalog-v2:[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "plan_id": {"$ref": "#/$defs/stableId"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "regulation_revision": {"type": "string", "minLength": 1},
    "target_source_manifest_hash": {"$ref": "#/$defs/sha256"},
    "target_pool_hash": {"$ref": "#/$defs/sha256"},
    "source_review_hash": {"$ref": "#/$defs/sha256"},
    "mapping_workbench_hash": {"$ref": "#/$defs/sha256"},
    "authorization_status": {"const": "not_authorization"},
    "payload_policy": {"const": "restricted_local_git_external"},
    "types_inventory_hash": {"$ref": "#/$defs/sha256"},
    "species": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/speciesEntity"}
    },
    "moves": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/moveEntity"}
    },
    "abilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/abilityEntity"}
    },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/itemEntity"}
    },
    "types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/typeEntity"}
    },
    "mega_relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/megaRelation"}
    },
    "summary": {"$ref": "#/$defs/catalogSummary"},
    "catalog_workbench_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableStableId": {
      "oneOf": [
        {"$ref": "#/$defs/stableId"},
        {"type": "null"}
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "targetKey": {
      "type": "string",
      "pattern": "^dex:[0-9]{4,}:form:[0-9A-Za-z_-]+:variant:[0-9A-Za-z_-]+$"
    },
    "evidenceField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "source_refs", "note"],
      "properties": {
        "status": {
          "enum": ["candidate_unreviewed", "missing", "unknown_semantics"]
        },
        "value": {
          "description": "Opaque candidate value retained from a Git-external source record."
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "missing"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "value": {"type": "null"},
              "source_refs": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "unknown_semantics"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"value": {"type": "null"}}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "candidate_unreviewed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"source_refs": {"minItems": 1}}
          }
        }
      ]
    },
    "candidateOrMissingStringField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {
          "properties": {
            "status": {"enum": ["candidate_unreviewed", "missing"]}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "candidate_unreviewed"}},
            "required": ["status"]
          },
          "then": {"properties": {"value": {"type": "string"}}}
        }
      ]
    },
    "candidateOrMissingIntegerField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {
          "properties": {
            "status": {"enum": ["candidate_unreviewed", "missing"]}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "candidate_unreviewed"}},
            "required": ["status"]
          },
          "then": {"properties": {"value": {"type": "integer"}}}
        }
      ]
    },
    "candidateOrMissingNullableIntegerField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {
          "properties": {
            "status": {"enum": ["candidate_unreviewed", "missing"]}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "candidate_unreviewed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"value": {"type": ["integer", "null"]}}
          }
        }
      ]
    },
    "candidateOrMissingIntegerArrayField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {
          "properties": {
            "status": {"enum": ["candidate_unreviewed", "missing"]}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "candidate_unreviewed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "integer"}
              }
            }
          }
        }
      ]
    },
    "abilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ability_id", "name"],
      "properties": {
        "ability_id": {"type": "integer"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "candidateOrMissingAbilityArrayField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {
          "properties": {
            "status": {"enum": ["candidate_unreviewed", "missing"]}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "candidate_unreviewed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/abilityReference"}
              }
            }
          }
        }
      ]
    },
    "candidateOrMissingFormRelationField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {
          "properties": {
            "status": {"enum": ["candidate_unreviewed", "missing"]}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "candidate_unreviewed"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mega_evolution_ids"],
                "properties": {
                  "mega_evolution_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {"$ref": "#/$defs/stableId"}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "effectivenessRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack_type_id", "defense_type_id", "multiplier"],
      "properties": {
        "attack_type_id": {"type": "integer"},
        "defense_type_id": {"type": "integer"},
        "multiplier": {"type": "number", "minimum": 0}
      }
    },
    "candidateEffectivenessField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {"properties": {"status": {"const": "candidate_unreviewed"}}},
        {
          "properties": {
            "value": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/effectivenessRecord"}
            }
          }
        }
      ]
    },
    "missingField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {"properties": {"status": {"const": "missing"}}}
      ]
    },
    "unknownSemanticsField": {
      "allOf": [
        {"$ref": "#/$defs/evidenceField"},
        {"properties": {"status": {"const": "unknown_semantics"}}}
      ]
    },
    "speciesFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "types",
        "base_stats",
        "abilities",
        "legal_moves",
        "form_relation"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "types": {"$ref": "#/$defs/candidateOrMissingIntegerArrayField"},
        "base_stats": {"$ref": "#/$defs/missingField"},
        "abilities": {"$ref": "#/$defs/candidateOrMissingAbilityArrayField"},
        "legal_moves": {"$ref": "#/$defs/candidateOrMissingIntegerArrayField"},
        "form_relation": {"$ref": "#/$defs/candidateOrMissingFormRelationField"}
      }
    },
    "speciesEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "catalog_candidate_id",
        "mapping_status",
        "source_record_sha256",
        "fields",
        "runtime_lowering_status"
      ],
      "properties": {
        "target_key": {"$ref": "#/$defs/targetKey"},
        "catalog_candidate_id": {"$ref": "#/$defs/nullableStableId"},
        "mapping_status": {
          "enum": ["candidate", "conflict", "unresolved"]
        },
        "source_record_sha256": {"$ref": "#/$defs/nullableSha256"},
        "fields": {"$ref": "#/$defs/speciesFields"},
        "runtime_lowering_status": {"const": "blocked"}
      }
    },
    "moveFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "category",
        "power",
        "accuracy",
        "pp",
        "priority",
        "target",
        "contact",
        "structured_effect"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "type": {"$ref": "#/$defs/candidateOrMissingIntegerField"},
        "category": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "power": {"$ref": "#/$defs/candidateOrMissingNullableIntegerField"},
        "accuracy": {"$ref": "#/$defs/candidateOrMissingNullableIntegerField"},
        "pp": {"$ref": "#/$defs/candidateOrMissingIntegerField"},
        "priority": {"$ref": "#/$defs/missingField"},
        "target": {"$ref": "#/$defs/candidateOrMissingIntegerField"},
        "contact": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "structured_effect": {"$ref": "#/$defs/unknownSemanticsField"}
      }
    },
    "moveEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "source_record_sha256",
        "fields",
        "runtime_lowering_status"
      ],
      "properties": {
        "entity_id": {"$ref": "#/$defs/stableId"},
        "source_record_sha256": {"$ref": "#/$defs/nullableSha256"},
        "fields": {"$ref": "#/$defs/moveFields"},
        "runtime_lowering_status": {"const": "blocked"}
      }
    },
    "effectEntityFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "trigger", "target", "structured_effect"],
      "properties": {
        "name": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "trigger": {"$ref": "#/$defs/unknownSemanticsField"},
        "target": {"$ref": "#/$defs/unknownSemanticsField"},
        "structured_effect": {"$ref": "#/$defs/unknownSemanticsField"}
      }
    },
    "abilityEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "source_record_sha256",
        "fields",
        "runtime_lowering_status"
      ],
      "properties": {
        "entity_id": {"$ref": "#/$defs/stableId"},
        "source_record_sha256": {"$ref": "#/$defs/nullableSha256"},
        "fields": {"$ref": "#/$defs/effectEntityFields"},
        "runtime_lowering_status": {"const": "blocked"}
      }
    },
    "itemEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "source_record_sha256",
        "fields",
        "runtime_lowering_status"
      ],
      "properties": {
        "entity_id": {"$ref": "#/$defs/stableId"},
        "source_record_sha256": {"$ref": "#/$defs/nullableSha256"},
        "fields": {"$ref": "#/$defs/effectEntityFields"},
        "runtime_lowering_status": {"const": "blocked"}
      }
    },
    "typeFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "effectiveness"],
      "properties": {
        "name": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "effectiveness": {"$ref": "#/$defs/candidateEffectivenessField"}
      }
    },
    "typeEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "source_record_sha256",
        "fields",
        "runtime_lowering_status"
      ],
      "properties": {
        "entity_id": {"$ref": "#/$defs/stableId"},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "fields": {"$ref": "#/$defs/typeFields"},
        "runtime_lowering_status": {"const": "blocked"}
      }
    },
    "megaRelationFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_form",
        "mega_form",
        "required_item",
        "base_stats",
        "mega_stats",
        "types",
        "ability"
      ],
      "properties": {
        "base_form": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "mega_form": {"$ref": "#/$defs/candidateOrMissingStringField"},
        "required_item": {"$ref": "#/$defs/missingField"},
        "base_stats": {"$ref": "#/$defs/missingField"},
        "mega_stats": {"$ref": "#/$defs/missingField"},
        "types": {"$ref": "#/$defs/candidateOrMissingIntegerArrayField"},
        "ability": {"$ref": "#/$defs/candidateOrMissingAbilityArrayField"}
      }
    },
    "megaRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "base_catalog_candidate_id",
        "mega_catalog_candidate_id",
        "fields",
        "runtime_lowering_status"
      ],
      "properties": {
        "relation_id": {"$ref": "#/$defs/stableId"},
        "base_catalog_candidate_id": {"$ref": "#/$defs/stableId"},
        "mega_catalog_candidate_id": {"$ref": "#/$defs/stableId"},
        "fields": {"$ref": "#/$defs/megaRelationFields"},
        "runtime_lowering_status": {"const": "blocked"}
      }
    },
    "fieldStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_unreviewed": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "unknown_semantics": {"type": "integer", "minimum": 0}
      }
    },
    "catalogSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "species_count",
        "move_count",
        "ability_count",
        "item_count",
        "type_count",
        "mega_relation_candidate_count",
        "required_field_count",
        "field_status_counts",
        "verified_field_count",
        "catalog_required_field_evidence_rate_ppm",
        "runtime_lowerable_entity_count",
        "production_catalog_ready"
      ],
      "properties": {
        "species_count": {"type": "integer", "minimum": 1},
        "move_count": {"type": "integer", "minimum": 0},
        "ability_count": {"type": "integer", "minimum": 0},
        "item_count": {"type": "integer", "minimum": 0},
        "type_count": {"type": "integer", "minimum": 0},
        "mega_relation_candidate_count": {"type": "integer", "minimum": 0},
        "required_field_count": {"type": "integer", "minimum": 0},
        "field_status_counts": {"$ref": "#/$defs/fieldStatusCounts"},
        "verified_field_count": {"const": 0},
        "catalog_required_field_evidence_rate_ppm": {"const": 0},
        "runtime_lowerable_entity_count": {"const": 0},
        "production_catalog_ready": {"const": false}
      }
    }
  }
}
