{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pokemon-auto-battle/schemas/sim02b-production-promotion-report-v2.schema.json",
  "title": "SIM-02B Production Promotion Report V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "compiler_id",
    "attestation_scope",
    "status",
    "promotion_gate_passed",
    "champions_candidate",
    "champions_fidelity_status",
    "rank1_equivalence_status",
    "regulation_id",
    "regulation_revision",
    "component_hashes",
    "metrics",
    "external_holdout_novel_gap_count",
    "silent_fallback_count",
    "decision_lead_time_seconds",
    "timing_evidence",
    "blockers",
    "resume_conditions",
    "documents",
    "report_hash"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "report_id": {
      "type": "string",
      "pattern": "^promotion-report-[0-9a-f]{64}$"
    },
    "compiler_id": {"const": "production-promotion-v2"},
    "attestation_scope": {
      "enum": ["test_authoritative", "production_champions"]
    },
    "status": {
      "enum": ["engineering_candidate", "production_candidate"]
    },
    "promotion_gate_passed": {"const": true},
    "champions_candidate": {"type": "boolean"},
    "champions_fidelity_status": {
      "enum": ["not_attested", "evidence_attested"]
    },
    "rank1_equivalence_status": {"const": "unmeasured"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "regulation_revision": {"$ref": "#/$defs/stableId"},
    "component_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_resolution_set_hash",
        "artifact_binding_hash",
        "regulation_hash",
        "target_pool_hash",
        "catalog_hash",
        "ruleset_hash",
        "mapping_evidence_hash",
        "target_pool_manifest_hash",
        "semantic_compilation_hash",
        "target_capability_set_hash",
        "execution_compilation_hash",
        "construction_corpus_hash",
        "scenario_corpus_hash",
        "external_holdout_scenario_corpus_hash",
        "partition_manifest_hash",
        "external_holdout_hash",
        "grounding_resolution_hash",
        "engine_probe_report_hash",
        "mechanic_coverage_matrix_hash",
        "timing_evidence_hash"
      ],
      "properties": {
        "source_resolution_set_hash": {"$ref": "#/$defs/sha256"},
        "artifact_binding_hash": {"$ref": "#/$defs/sha256"},
        "regulation_hash": {"$ref": "#/$defs/sha256"},
        "target_pool_hash": {"$ref": "#/$defs/sha256"},
        "catalog_hash": {"$ref": "#/$defs/sha256"},
        "ruleset_hash": {"$ref": "#/$defs/sha256"},
        "mapping_evidence_hash": {"$ref": "#/$defs/sha256"},
        "target_pool_manifest_hash": {"$ref": "#/$defs/sha256"},
        "semantic_compilation_hash": {"$ref": "#/$defs/sha256"},
        "target_capability_set_hash": {"$ref": "#/$defs/sha256"},
        "execution_compilation_hash": {"$ref": "#/$defs/sha256"},
        "construction_corpus_hash": {"$ref": "#/$defs/sha256"},
        "scenario_corpus_hash": {"$ref": "#/$defs/sha256"},
        "external_holdout_scenario_corpus_hash": {"$ref": "#/$defs/sha256"},
        "partition_manifest_hash": {"$ref": "#/$defs/sha256"},
        "external_holdout_hash": {"$ref": "#/$defs/sha256"},
        "grounding_resolution_hash": {"$ref": "#/$defs/sha256"},
        "engine_probe_report_hash": {"$ref": "#/$defs/sha256"},
        "mechanic_coverage_matrix_hash": {"$ref": "#/$defs/sha256"},
        "timing_evidence_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_target_mapping_rate",
        "development_scenario_coverage_rate",
        "verified_grounding_conformance_rate",
        "engine_probe_pass_rate"
      ],
      "properties": {
        "verified_target_mapping_rate": {
          "allOf": [
            {"$ref": "#/$defs/exactPromotionRate"},
            {
              "properties": {
                "metric_id": {"const": "verified_target_mapping_rate"}
              }
            }
          ]
        },
        "development_scenario_coverage_rate": {
          "allOf": [
            {"$ref": "#/$defs/exactPromotionRate"},
            {
              "properties": {
                "metric_id": {"const": "development_scenario_coverage_rate"}
              }
            }
          ]
        },
        "verified_grounding_conformance_rate": {
          "allOf": [
            {"$ref": "#/$defs/exactPromotionRate"},
            {
              "properties": {
                "metric_id": {"const": "verified_grounding_conformance_rate"}
              }
            }
          ]
        },
        "engine_probe_pass_rate": {
          "allOf": [
            {"$ref": "#/$defs/exactPromotionRate"},
            {
              "properties": {
                "metric_id": {"const": "engine_probe_pass_rate"}
              }
            }
          ]
        }
      }
    },
    "external_holdout_novel_gap_count": {"const": 0},
    "silent_fallback_count": {"const": 0},
    "decision_lead_time_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 172800
    },
    "timing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing_id",
        "measurement_status",
        "t0",
        "t_decision",
        "compute_seconds",
        "manual_seconds",
        "external_wait_seconds",
        "lead_time_seconds"
      ],
      "properties": {
        "timing_id": {"$ref": "#/$defs/stableId"},
        "measurement_status": {"enum": ["test_fixed", "measured"]},
        "t0": {"$ref": "#/$defs/timezoneTimestamp"},
        "t_decision": {"$ref": "#/$defs/timezoneTimestamp"},
        "compute_seconds": {"type": "integer", "minimum": 0},
        "manual_seconds": {"type": "integer", "minimum": 0},
        "external_wait_seconds": {"type": "integer", "minimum": 0},
        "lead_time_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 172800
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 0
    },
    "resume_conditions": {
      "type": "array",
      "maxItems": 0
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/documentDigest"}
    },
    "report_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "required": ["attestation_scope"],
        "properties": {
          "attestation_scope": {"const": "test_authoritative"}
        }
      },
      "then": {
        "properties": {
          "status": {"const": "engineering_candidate"},
          "champions_candidate": {"const": false},
          "champions_fidelity_status": {"const": "not_attested"},
          "timing_evidence": {
            "properties": {
              "measurement_status": {"const": "test_fixed"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "status": {"const": "production_candidate"},
          "champions_candidate": {"const": true},
          "champions_fidelity_status": {"const": "evidence_attested"},
          "timing_evidence": {
            "properties": {
              "measurement_status": {"const": "measured"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "timezoneTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "exactPromotionRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "numerator",
        "denominator",
        "rate_ppm",
        "denominator_binding_hash"
      ],
      "properties": {
        "metric_id": {"$ref": "#/$defs/stableId"},
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "rate_ppm": {"const": 1000000},
        "denominator_binding_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "documentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "byte_count"],
      "properties": {
        "file_name": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
