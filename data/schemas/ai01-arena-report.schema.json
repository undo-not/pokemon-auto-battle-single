{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/champions-sim/ai01-arena-report.schema.json",
  "title": "AI-01 Arena Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arena_version",
    "plan",
    "matches",
    "summary",
    "decision",
    "champions_readiness_decision",
    "champions_candidate",
    "rank1_equivalence_status",
    "rank1_equivalence_claim_allowed",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "ai01-arena-report-v1"},
    "arena_version": {"const": "ai01-arena-1.0"},
    "plan": {"$ref": "#/$defs/plan"},
    "matches": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/match"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "decision": {"const": "synthetic_benchmark_complete"},
    "champions_readiness_decision": {"const": "no_go"},
    "champions_candidate": {"const": false},
    "rank1_equivalence_status": {"const": "unmeasured"},
    "rank1_equivalence_claim_allowed": {"const": false},
    "blockers": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "champions_fidelity_not_verified"}},
        {"contains": {"const": "policy_process_isolation_not_implemented"}},
        {"contains": {"const": "rank1_external_calibration_missing"}}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "version",
        "implementation_hash",
        "implementation_components",
        "component_source_hashes",
        "component_runtime_hashes",
        "battle_policy_component",
        "configuration_json",
        "configuration_hash",
        "observation_contract"
      ],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_hash": {"$ref": "#/$defs/sha256"},
        "implementation_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "component_source_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentSourceHash"}
        },
        "component_runtime_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentSourceHash"}
        },
        "battle_policy_component": {"type": "string", "minLength": 1},
        "configuration_json": {"type": "string", "minLength": 2},
        "configuration_hash": {"$ref": "#/$defs/sha256"},
        "observation_contract": {"type": "string", "minLength": 1}
      }
    },
    "componentSourceHash": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/sha256"}
      ],
      "items": false
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "scenario_id",
        "partition",
        "pair_count",
        "engine_seed_start",
        "agent_seed_start",
        "catalog_id",
        "catalog_hash",
        "ruleset_id",
        "ruleset_hash",
        "initial_state_hash",
        "candidate",
        "opponent",
        "scope"
      ],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "partition": {"enum": ["development", "holdout"]},
        "pair_count": {"type": "integer", "minimum": 1},
        "engine_seed_start": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "agent_seed_start": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "catalog_id": {"type": "string", "minLength": 1},
        "catalog_hash": {"$ref": "#/$defs/sha256"},
        "ruleset_id": {"type": "string", "minLength": 1},
        "ruleset_hash": {"$ref": "#/$defs/sha256"},
        "initial_state_hash": {"$ref": "#/$defs/sha256"},
        "candidate": {"$ref": "#/$defs/agent"},
        "opponent": {"$ref": "#/$defs/agent"},
        "scope": {"const": "synthetic_local"},
        "prebattle_session_hash": {"$ref": "#/$defs/sha256"},
        "prebattle_proof_hash": {"$ref": "#/$defs/sha256"},
        "provisional_decision_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "dependentRequired": {
        "prebattle_session_hash": ["prebattle_proof_hash"],
        "prebattle_proof_hash": ["prebattle_session_hash"]
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_index",
        "engine_seed",
        "agent_seed",
        "leg",
        "candidate_player",
        "winner",
        "candidate_outcome",
        "terminal_utility",
        "replay_hash",
        "final_state_hash",
        "decision_windows",
        "event_count",
        "replay_verified"
      ],
      "properties": {
        "pair_index": {"type": "integer", "minimum": 0},
        "engine_seed": {"type": "integer", "minimum": 0},
        "agent_seed": {"type": "integer", "minimum": 0},
        "leg": {"enum": ["candidate_p1", "candidate_p2"]},
        "candidate_player": {"enum": ["p1", "p2"]},
        "winner": {"type": ["string", "null"], "enum": ["p1", "p2", null]},
        "candidate_outcome": {"enum": ["win", "draw", "loss"]},
        "terminal_utility": {"enum": [-1, 0, 1]},
        "replay_hash": {"$ref": "#/$defs/sha256"},
        "final_state_hash": {"$ref": "#/$defs/sha256"},
        "decision_windows": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 1},
        "replay_verified": {"const": true}
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches", "wins", "draws", "losses"],
      "properties": {
        "matches": {"type": "integer", "minimum": 0},
        "wins": {"type": "integer", "minimum": 0},
        "draws": {"type": "integer", "minimum": 0},
        "losses": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairs",
        "matches",
        "wins",
        "draws",
        "losses",
        "net_utility_numerator",
        "net_utility_denominator",
        "paired_net_utility_ppm",
        "pair_completeness_rate_ppm",
        "legal_action_rate_ppm",
        "replay_verification_rate_ppm",
        "private_state_delivery_violation_count",
        "execution_error_count",
        "candidate_as_p1",
        "candidate_as_p2"
      ],
      "properties": {
        "pairs": {"type": "integer", "minimum": 1},
        "matches": {"type": "integer", "minimum": 2},
        "wins": {"type": "integer", "minimum": 0},
        "draws": {"type": "integer", "minimum": 0},
        "losses": {"type": "integer", "minimum": 0},
        "net_utility_numerator": {"type": "integer"},
        "net_utility_denominator": {"type": "integer", "minimum": 2},
        "paired_net_utility_ppm": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "pair_completeness_rate_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "legal_action_rate_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "replay_verification_rate_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "private_state_delivery_violation_count": {"type": "integer", "minimum": 0},
        "execution_error_count": {"type": "integer", "minimum": 0},
        "candidate_as_p1": {"$ref": "#/$defs/seat"},
        "candidate_as_p2": {"$ref": "#/$defs/seat"}
      }
    }
  }
}
