{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-resolved-production-trust-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "attestation_id",
    "attestation_hash",
    "subject_hash",
    "policy_id",
    "policy_epoch",
    "policy_sha256",
    "issuer_id",
    "key_id",
    "key_fingerprint_sha256",
    "algorithm",
    "namespace",
    "verified_at",
    "ledger_binding_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "domain": {"const": "champions-sim.production-trust-attestation.v1"},
    "attestation_id": {"$ref": "#/$defs/stableId"},
    "attestation_hash": {"$ref": "#/$defs/sha256"},
    "subject_hash": {"$ref": "#/$defs/sha256"},
    "policy_id": {"$ref": "#/$defs/stableId"},
    "policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "issuer_id": {"$ref": "#/$defs/stableId"},
    "key_id": {"$ref": "#/$defs/stableId"},
    "key_fingerprint_sha256": {
      "type": "string",
      "pattern": "^SHA256:[A-Za-z0-9+/]+$"
    },
    "algorithm": {"const": "ssh-ed25519"},
    "namespace": {"const": "champions-sim-production-trust-v1"},
    "verified_at": {"$ref": "#/$defs/timestamp"},
    "ledger_binding_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
