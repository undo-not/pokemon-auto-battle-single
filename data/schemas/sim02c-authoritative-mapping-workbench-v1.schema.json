{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02c-authoritative-mapping-workbench-v1",
  "title": "SIM-02C-A Authoritative Mapping Workbench V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "workbench_id",
    "plan_id",
    "regulation_id",
    "regulation_revision",
    "target_source_manifest_ids",
    "target_source_manifest_hash",
    "target_pool_hash",
    "source_lock_hash",
    "intake_bundle_hash",
    "authorization_status",
    "denominator_final",
    "members",
    "summary",
    "mapping_workbench_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "compiler_version": {"const": "1.0.0"},
    "workbench_id": {
      "type": "string",
      "pattern": "^mapping:[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "plan_id": {"$ref": "#/$defs/stableId"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "regulation_revision": {"type": "string", "minLength": 1},
    "target_source_manifest_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "target_source_manifest_hash": {"$ref": "#/$defs/sha256"},
    "target_pool_hash": {"$ref": "#/$defs/sha256"},
    "source_lock_hash": {"$ref": "#/$defs/sha256"},
    "intake_bundle_hash": {"$ref": "#/$defs/sha256"},
    "authorization_status": {"const": "not_authorization"},
    "denominator_final": {"type": "boolean"},
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/mappingMember"}
    },
    "summary": {"$ref": "#/$defs/mappingSummary"},
    "mapping_workbench_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableStableId": {
      "oneOf": [
        {"$ref": "#/$defs/stableId"},
        {"type": "null"}
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "targetKey": {
      "type": "string",
      "pattern": "^dex:[0-9]{4,}:form:[0-9A-Za-z_-]+:variant:[0-9A-Za-z_-]+$"
    },
    "sourceEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "entity_id",
        "form_id",
        "variant_id",
        "record_sha256",
        "evidence_status"
      ],
      "properties": {
        "namespace": {"const": "yakkun_champions"},
        "entity_id": {"$ref": "#/$defs/stableId"},
        "form_id": {"type": "null"},
        "variant_id": {"type": "null"},
        "record_sha256": {"$ref": "#/$defs/nullableSha256"},
        "evidence_status": {"const": "candidate_unreviewed"}
      }
    },
    "mappingMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "target_namespace",
        "target_record_sha256",
        "national_dex_no",
        "form_code",
        "variant_code",
        "label",
        "resolution_status",
        "verification_status",
        "mapping_basis",
        "source_record_key",
        "selected_catalog_candidate_id",
        "candidate_catalog_ids",
        "source_entities",
        "review_decision_id",
        "promotion_eligible"
      ],
      "properties": {
        "target_key": {"$ref": "#/$defs/targetKey"},
        "target_namespace": {"const": "champions_target"},
        "target_record_sha256": {"$ref": "#/$defs/sha256"},
        "national_dex_no": {"type": "integer", "minimum": 1},
        "form_code": {
          "type": "string",
          "pattern": "^[0-9A-Za-z_-]{2,}$"
        },
        "variant_code": {
          "type": "string",
          "pattern": "^[0-9A-Za-z_-]+$"
        },
        "label": {"type": "string", "minLength": 1},
        "resolution_status": {
          "enum": ["candidate", "conflict", "unresolved"]
        },
        "verification_status": {"const": "unverified"},
        "mapping_basis": {"type": "string", "minLength": 1},
        "source_record_key": {"type": "string", "minLength": 1},
        "selected_catalog_candidate_id": {
          "$ref": "#/$defs/nullableStableId"
        },
        "candidate_catalog_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "source_entities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceEntity"}
        },
        "review_decision_id": {"type": "null"},
        "promotion_eligible": {"const": false}
      }
    },
    "mappingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_member_count",
        "candidate_count",
        "conflict_count",
        "unresolved_count",
        "verified_count",
        "promotion_unresolved_count",
        "reviewed_mapping_count",
        "namespace_form_complete_count",
        "authoritative_mapping_rate_ppm"
      ],
      "properties": {
        "target_member_count": {"type": "integer", "minimum": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"type": "integer", "minimum": 0},
        "verified_count": {"const": 0},
        "promotion_unresolved_count": {"type": "integer", "minimum": 0},
        "reviewed_mapping_count": {"const": 0},
        "namespace_form_complete_count": {"const": 0},
        "authoritative_mapping_rate_ppm": {"const": 0}
      }
    }
  }
}
