{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:target-mapping-evidence:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mapping_set_id", "target_pool_hash", "catalog_hash", "entries", "evidence_refs", "source_manifest_ids"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "mapping_set_id": {"$ref": "#/$defs/id"},
    "target_pool_hash": {"$ref": "#/$defs/sha"}, "catalog_hash": {"$ref": "#/$defs/sha"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "source_manifest_ids": {"$ref": "#/$defs/ids"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_ref_id", "source_manifest_id", "artifact_id", "json_pointer", "record_sha256"], "properties": {"evidence_ref_id": {"$ref": "#/$defs/id"}, "source_manifest_id": {"$ref": "#/$defs/id"}, "artifact_id": {"$ref": "#/$defs/id"}, "json_pointer": {"type": "string", "pattern": "^/"}, "record_sha256": {"$ref": "#/$defs/sha"}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["target_key", "catalog_pokemon_id", "resolution_status", "verification_status", "mapping_method", "candidate_pokemon_ids", "evidence_ref_ids"], "properties": {"target_key": {"$ref": "#/$defs/id"}, "catalog_pokemon_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "resolution_status": {"enum": ["resolved", "unresolved", "conflict"]}, "verification_status": {"enum": ["verified", "partially_verified", "unverified"]}, "mapping_method": {"$ref": "#/$defs/id"}, "candidate_pokemon_ids": {"$ref": "#/$defs/ids"}, "evidence_ref_ids": {"$ref": "#/$defs/ids"}}}
  }
}
