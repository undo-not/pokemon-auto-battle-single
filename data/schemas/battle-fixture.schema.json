{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:sim01-battle-fixture:1",
  "title": "SIM-01 Battle Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "battle_id", "ruleset_id", "catalog_id", "seed", "sides"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "battle_id": {
      "$ref": "#/$defs/stableId"
    },
    "ruleset_id": {
      "$ref": "#/$defs/stableId"
    },
    "catalog_id": {
      "$ref": "#/$defs/stableId"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "sides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p1", "p2"],
      "properties": {
        "p1": {
          "$ref": "#/$defs/side"
        },
        "p2": {
          "$ref": "#/$defs/side"
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "team"],
      "properties": {
        "active": {
          "$ref": "#/$defs/stableId"
        },
        "team": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/pokemon"
          }
        }
      }
    },
    "pokemon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "pokemon_id",
        "ability_id",
        "item_id",
        "stats",
        "moves"
      ],
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/stableId"
        },
        "pokemon_id": {
          "$ref": "#/$defs/stableId"
        },
        "ability_id": {
          "$ref": "#/$defs/stableId"
        },
        "item_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "$ref": "#/$defs/stats"
        },
        "mega_evolution_profile": {
          "$ref": "#/$defs/megaEvolutionProfile"
        },
        "moves": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        }
      }
    },
    "megaEvolutionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_pokemon_id",
        "stats",
        "level",
        "ivs",
        "evs",
        "nature_increased_stat",
        "nature_decreased_stat",
        "derivation_method_id",
        "source_manifest_id",
        "source_record_id",
        "profile_hash"
      ],
      "properties": {
        "target_pokemon_id": {"$ref": "#/$defs/stableId"},
        "stats": {"$ref": "#/$defs/stats"},
        "level": {"type": "integer", "minimum": 1, "maximum": 100},
        "ivs": {"$ref": "#/$defs/ivStats"},
        "evs": {"$ref": "#/$defs/evStats"},
        "nature_increased_stat": {"$ref": "#/$defs/nullableNatureStat"},
        "nature_decreased_stat": {"$ref": "#/$defs/nullableNatureStat"},
        "derivation_method_id": {"const": "pokemon-mainline-stat-v1"},
        "source_manifest_id": {"$ref": "#/$defs/stableId"},
        "source_record_id": {"$ref": "#/$defs/stableId"},
        "profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "nullableNatureStat": {
      "type": ["string", "null"],
      "enum": [null, "attack", "defense", "special_attack", "special_defense", "speed"]
    },
    "ivStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "properties": {
        "hp": {"type": "integer", "minimum": 0, "maximum": 31},
        "atk": {"type": "integer", "minimum": 0, "maximum": 31},
        "def": {"type": "integer", "minimum": 0, "maximum": 31},
        "spa": {"type": "integer", "minimum": 0, "maximum": 31},
        "spd": {"type": "integer", "minimum": 0, "maximum": 31},
        "spe": {"type": "integer", "minimum": 0, "maximum": 31}
      }
    },
    "evStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "properties": {
        "hp": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "atk": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "def": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "spa": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "spd": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4},
        "spe": {"type": "integer", "minimum": 0, "maximum": 252, "multipleOf": 4}
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "atk", "def", "spa", "spd", "spe"],
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 1
        },
        "atk": {
          "type": "integer",
          "minimum": 1
        },
        "def": {
          "type": "integer",
          "minimum": 1
        },
        "spa": {
          "type": "integer",
          "minimum": 1
        },
        "spd": {
          "type": "integer",
          "minimum": 1
        },
        "spe": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
