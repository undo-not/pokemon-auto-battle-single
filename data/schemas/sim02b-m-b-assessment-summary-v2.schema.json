{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions-sim:schema:sim02b-m-b-assessment-summary-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "regulation_id",
    "regulation_revision",
    "evaluation_scope",
    "source_report_hash",
    "assessment_hash",
    "status",
    "promotion_candidate",
    "champions_candidate",
    "rank1_equivalence_status",
    "target_members",
    "verified_target_mapping",
    "mapping_unresolved",
    "mapping_conflict",
    "semantic_selectors",
    "target_capability_rows",
    "execution_gaps",
    "probe_unexpected_errors",
    "silent_fallback_count",
    "development_scenario_coverage_rate_ppm",
    "verified_grounding_conformance_rate_ppm",
    "engine_probe_pass_rate_ppm",
    "external_holdout_novel_gap_count",
    "diagnostic_blocking_reason_count",
    "promotion_blocker_count",
    "production_trust_anchor_status",
    "large_assessment_storage"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "regulation_id": {"const": "M-B"},
    "regulation_revision": {"const": "official-2026-06-17"},
    "evaluation_scope": {"const": "local_diagnostic_summary"},
    "source_report_hash": {"$ref": "#/$defs/sha256"},
    "assessment_hash": {"$ref": "#/$defs/sha256"},
    "status": {"const": "no_go"},
    "promotion_candidate": {"const": false},
    "champions_candidate": {"const": false},
    "rank1_equivalence_status": {"const": "unmeasured"},
    "target_members": {"type": "integer", "minimum": 1},
    "verified_target_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "rate_ppm"],
      "properties": {
        "numerator": {"const": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "rate_ppm": {"const": 0}
      }
    },
    "mapping_unresolved": {"type": "integer", "minimum": 0},
    "mapping_conflict": {"type": "integer", "minimum": 0},
    "semantic_selectors": {"type": "integer", "minimum": 0},
    "target_capability_rows": {"type": "integer", "minimum": 0},
    "execution_gaps": {"type": "integer", "minimum": 0},
    "probe_unexpected_errors": {"type": "integer", "minimum": 0},
    "silent_fallback_count": {"type": "integer", "minimum": 0},
    "development_scenario_coverage_rate_ppm": {"type": "null"},
    "verified_grounding_conformance_rate_ppm": {"type": "null"},
    "engine_probe_pass_rate_ppm": {"type": "null"},
    "external_holdout_novel_gap_count": {"type": "null"},
    "diagnostic_blocking_reason_count": {"type": "integer", "minimum": 1},
    "promotion_blocker_count": {"type": "integer", "minimum": 1},
    "production_trust_anchor_status": {"const": "not_implemented"},
    "large_assessment_storage": {"const": "gitignored_data_processed_only"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
