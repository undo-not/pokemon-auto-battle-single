{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:regulation-snapshot:1",
  "title": "SIM-02 Regulation Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "regulation_id", "revision", "title", "status",
    "verification_status", "published_at", "period", "battle_format",
    "team_size", "level", "item_clause", "battle_timer",
    "required_mechanics", "source_manifest_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "revision": {"$ref": "#/$defs/stableId"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["current", "archived", "synthetic"]},
    "verification_status": {"enum": ["verified", "partially_verified", "synthetic_rehearsal"]},
    "published_at": {"type": ["string", "null"]},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_at", "timezone"],
      "properties": {
        "start_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "end_at": {"type": "string", "minLength": 1},
        "timezone": {"const": "Asia/Tokyo"}
      }
    },
    "battle_format": {"const": "singles_3v3"},
    "team_size": {"const": 3},
    "level": {"type": "integer", "minimum": 1, "maximum": 100},
    "item_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["held_items_enabled", "duplicate_held_items_allowed"],
      "properties": {
        "held_items_enabled": {"type": "boolean"},
        "duplicate_held_items_allowed": {"type": "boolean"}
      }
    },
    "battle_timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_minutes", "player_minutes", "turn_seconds", "selection_seconds"],
      "properties": {
        "total_minutes": {"type": "integer", "minimum": 1},
        "player_minutes": {"type": "integer", "minimum": 1},
        "turn_seconds": {"type": "integer", "minimum": 1},
        "selection_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "required_mechanics": {"$ref": "#/$defs/stableIds"},
    "source_manifest_ids": {
      "allOf": [{"$ref": "#/$defs/stableIds"}],
      "minItems": 1
    }
  },
  "$defs": {
    "stableId": {
      "type": "string", "minLength": 1, "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "stableIds": {
      "type": "array", "items": {"$ref": "#/$defs/stableId"}, "uniqueItems": true
    }
  }
}
