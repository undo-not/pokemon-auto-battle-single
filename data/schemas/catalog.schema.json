{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:sim01-catalog:1",
  "title": "SIM-01 Catalog Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "engine_semantics_version",
    "source_manifest_id",
    "type_chart_default_multiplier",
    "types",
    "type_chart",
    "abilities",
    "items",
    "moves",
    "species"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "catalog_id": {
      "$ref": "#/$defs/stableId"
    },
    "engine_semantics_version": {
      "$ref": "#/$defs/stableId"
    },
    "source_manifest_id": {
      "$ref": "#/$defs/stableId"
    },
    "type_chart_default_multiplier": {
      "const": 1
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/typeDefinition"
      }
    },
    "type_chart": {
      "type": "object",
      "description": "Sparse type chart. Omitted valid type pairs use type_chart_default_multiplier, which is exactly 1 in SIM-01.",
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "$ref": "#/$defs/stableId"
        },
        "additionalProperties": {
          "enum": [0, 0.25, 0.5, 1, 2, 4]
        }
      }
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/abilityDefinition"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/itemDefinition"
      }
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/moveDefinition"
      }
    },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/speciesDefinition"
      }
    },
    "mega_evolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/megaEvolutionDefinition"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uniqueStableIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "legacyIntegerId": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "typeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_id", "legacy_type_id", "name"],
      "properties": {
        "type_id": {
          "$ref": "#/$defs/stableId"
        },
        "legacy_type_id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "abilityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ability_id", "legacy_ability_id", "name", "effect_id"],
      "properties": {
        "ability_id": {
          "$ref": "#/$defs/stableId"
        },
        "legacy_ability_id": {
          "$ref": "#/$defs/legacyIntegerId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unsupported_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {"properties": {"effect_id": {"pattern": "^unsupported:"}}},
          "then": {"required": ["source_record_sha256", "unsupported_reason"]}
        }
      ]
    },
    "itemDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "legacy_item_id", "name", "effect_id"],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/stableId"
        },
        "legacy_item_id": {
          "$ref": "#/$defs/legacyIntegerId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "effect_id": {
          "$ref": "#/$defs/stableId"
        },
        "consumable": {
          "type": ["boolean", "null"]
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unsupported_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["consumable"],
            "properties": {"consumable": {"type": "null"}}
          },
          "then": {
            "properties": {"effect_id": {"pattern": "^unsupported:"}}
          }
        },
        {
          "if": {"properties": {"effect_id": {"pattern": "^unsupported:"}}},
          "then": {"required": ["source_record_sha256", "unsupported_reason"]}
        }
      ]
    },
    "moveDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_id",
        "legacy_move_id",
        "name",
        "type_id",
        "category",
        "power",
        "accuracy",
        "pp",
        "priority",
        "contact",
        "effect"
      ],
      "properties": {
        "move_id": {
          "$ref": "#/$defs/stableId"
        },
        "legacy_move_id": {
          "$ref": "#/$defs/legacyIntegerId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type_id": {
          "$ref": "#/$defs/stableId"
        },
        "category": {
          "enum": ["physical", "special", "status"]
        },
        "power": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "accuracy": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "pp": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "type": ["integer", "null"],
          "minimum": -7,
          "maximum": 7
        },
        "contact": {
          "type": "boolean"
        },
        "effect": {
          "$ref": "#/$defs/moveEffect"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"priority": {"type": "null"}}},
          "then": {
            "properties": {
              "effect": {"properties": {"kind": {"const": "unsupported"}}}
            }
          }
        }
      ]
    },
    "moveEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "damage",
            "raise_self",
            "damage_secondary_status",
            "damage_secondary_stage",
            "damage_secondary_flinch",
            "heal_self",
            "damage_drain",
            "inflict_status",
            "unsupported"
          ]
        },
        "status": {
          "enum": ["burn", "poison"]
        },
        "target": {
          "enum": ["self", "opponent"]
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "atk": {
              "type": "integer",
              "minimum": -6,
              "maximum": 6
            },
            "def": {
              "type": "integer",
              "minimum": -6,
              "maximum": 6
            },
            "spa": {
              "type": "integer",
              "minimum": -6,
              "maximum": 6
            },
            "spd": {
              "type": "integer",
              "minimum": -6,
              "maximum": 6
            },
            "spe": {
              "type": "integer",
              "minimum": -6,
              "maximum": 6
            }
          }
        },
        "chance_numerator": {
          "type": "integer",
          "minimum": 0
        },
        "chance_denominator": {
          "type": "integer",
          "minimum": 1
        },
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "unsupported"}}},
          "then": {"required": ["source_record_sha256", "reason"]}
        }
      ]
    },
    "baseStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "attack", "defense", "special_attack", "special_defense", "speed"],
      "properties": {
        "hp": {"type": "integer", "minimum": 1},
        "attack": {"type": "integer", "minimum": 1},
        "defense": {"type": "integer", "minimum": 1},
        "special_attack": {"type": "integer", "minimum": 1},
        "special_defense": {"type": "integer", "minimum": 1},
        "speed": {"type": "integer", "minimum": 1}
      }
    },
    "megaEvolutionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_pokemon_id",
        "mega_pokemon_id",
        "required_item_id",
        "base_stats",
        "mega_stats",
        "types",
        "ability_id",
        "source_manifest_id"
      ],
      "properties": {
        "base_pokemon_id": {"$ref": "#/$defs/stableId"},
        "mega_pokemon_id": {"$ref": "#/$defs/stableId"},
        "required_item_id": {"$ref": "#/$defs/stableId"},
        "base_stats": {"$ref": "#/$defs/baseStats"},
        "mega_stats": {"$ref": "#/$defs/baseStats"},
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "ability_id": {"$ref": "#/$defs/stableId"},
        "source_manifest_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "speciesDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pokemon_id",
        "legacy_pokemon_id",
        "name",
        "types",
        "ability_ids",
        "legal_move_ids"
      ],
      "properties": {
        "pokemon_id": {
          "$ref": "#/$defs/stableId"
        },
        "legacy_pokemon_id": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "ability_ids": {
          "$ref": "#/$defs/uniqueStableIds"
        },
        "legal_move_ids": {
          "$ref": "#/$defs/uniqueStableIds"
        }
      }
    }
  }
}
