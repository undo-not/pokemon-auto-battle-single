{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:capture-manifest:2",
  "title": "ChampionSim authorized external observation capture manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "captured_at",
    "ui_hierarchy_before_captured_at",
    "screenshot_captured_at",
    "ui_hierarchy_captured_at",
    "ui_state_sha256",
    "instance_name",
    "adb_serial",
    "format_id",
    "plan_id",
    "plan_hash",
    "lineage_receipt_sha256",
    "plan_seal_comment_url",
    "plan_seal_receipt_sha256",
    "partition",
    "target_package",
    "client_build",
    "capture_store_id",
    "capture_store_identity_sha256",
    "authorization_id",
    "authorization_sha256",
    "game_input_performed",
    "adb_server_ownership_verified",
    "adb_server",
    "artifacts",
    "redaction_status",
    "redaction_regions",
    "annotations",
    "contains_sensitive_content",
    "local_research_only",
    "distribution_allowed"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "capture_id": {"$ref": "#/$defs/captureId"},
    "captured_at": {"type": "string", "format": "date-time"},
    "ui_hierarchy_before_captured_at": {"type": "string", "format": "date-time"},
    "screenshot_captured_at": {"type": "string", "format": "date-time"},
    "ui_hierarchy_captured_at": {"type": "string", "format": "date-time"},
    "ui_state_sha256": {"$ref": "#/$defs/sha256Prefixed"},
    "instance_name": {"$ref": "#/$defs/stableId"},
    "adb_serial": {"type": "string", "pattern": "^127\\.0\\.0\\.1:[1-9][0-9]{0,4}$"},
    "format_id": {"$ref": "#/$defs/stableId"},
    "plan_id": {"$ref": "#/$defs/stableId"},
    "plan_hash": {"$ref": "#/$defs/sha256Prefixed"},
    "lineage_receipt_sha256": {"$ref": "#/$defs/sha256Prefixed"},
    "plan_seal_comment_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
    },
    "plan_seal_receipt_sha256": {"$ref": "#/$defs/sha256Prefixed"},
    "partition": {"enum": ["development", "holdout"]},
    "target_package": {"$ref": "#/$defs/androidPackage"},
    "client_build": {"$ref": "#/$defs/clientBuild"},
    "capture_store_id": {"$ref": "#/$defs/stableId"},
    "capture_store_identity_sha256": {"$ref": "#/$defs/sha256Prefixed"},
    "authorization_id": {"$ref": "#/$defs/stableId"},
    "authorization_sha256": {"$ref": "#/$defs/sha256Prefixed"},
    "game_input_performed": {"const": false},
    "adb_server_ownership_verified": {"const": true},
    "adb_server": {"$ref": "#/$defs/adbServer"},
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/artifact"},
      "uniqueItems": true
    },
    "redaction_status": {
      "enum": ["unreviewed", "annotated", "cleared_local_only"]
    },
    "redaction_regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/redactionRegion"}
    },
    "annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/annotation"}
    },
    "contains_sensitive_content": {"type": ["boolean", "null"]},
    "local_research_only": {"const": true},
    "distribution_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["redaction_status"],
        "properties": {"redaction_status": {"const": "unreviewed"}}
      },
      "then": {
        "properties": {"contains_sensitive_content": {"const": null}}
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "required": ["artifact_id", "kind", "relative_path", "media_type"],
            "properties": {
              "artifact_id": {"const": "screenshot"},
              "kind": {"const": "screenshot"},
              "relative_path": {"const": "screenshot.png"},
              "media_type": {"const": "image/png"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "required": ["artifact_id", "kind", "relative_path", "media_type"],
            "properties": {
              "artifact_id": {"const": "ui-hierarchy"},
              "kind": {"const": "ui_hierarchy"},
              "relative_path": {"const": "ui-hierarchy.xml"},
              "media_type": {"const": "application/xml"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "required": ["artifact_id", "kind", "relative_path", "media_type"],
            "properties": {
              "artifact_id": {"const": "ui-hierarchy-before"},
              "kind": {"const": "ui_hierarchy"},
              "relative_path": {"const": "ui-hierarchy-before.xml"},
              "media_type": {"const": "application/xml"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256Prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^capture-[0-9a-f]{64}$"
    },
    "androidPackage": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "clientBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_code", "version_name", "apk_count", "apk_set_sha256"],
      "properties": {
        "version_code": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "version_name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
        "apk_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "apk_set_sha256": {"$ref": "#/$defs/sha256Prefixed"}
      }
    },
    "canonicalValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/canonicalValue"}},
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/canonicalValue"}
        }
      ]
    },
    "adbServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "process_id",
        "process_started_at",
        "executable_sha256",
        "transport"
      ],
      "properties": {
        "host": {"const": "127.0.0.1"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "process_id": {"type": "integer", "minimum": 1},
        "process_started_at": {"type": "string", "format": "date-time"},
        "executable_sha256": {"$ref": "#/$defs/sha256Prefixed"},
        "transport": {"const": "existing_server_socket"}
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "media_type",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "kind": {"enum": ["screenshot", "ui_hierarchy"]},
        "relative_path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256Prefixed"}
      }
    },
    "redactionRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "box", "reason"],
      "properties": {
        "region_id": {"$ref": "#/$defs/stableId"},
        "box": {"$ref": "#/$defs/box"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "label",
        "source",
        "confidence_ppm",
        "artifact_id",
        "box",
        "value"
      ],
      "properties": {
        "annotation_id": {"$ref": "#/$defs/stableId"},
        "label": {"type": "string", "minLength": 1},
        "source": {"enum": ["human", "detector", "ui_metadata"]},
        "confidence_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "box": {"oneOf": [{"$ref": "#/$defs/box"}, {"type": "null"}]},
        "value": {"$ref": "#/$defs/canonicalValue"}
      }
    }
  }
}
