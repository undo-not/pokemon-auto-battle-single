{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:capture-manifest:1",
  "title": "ChampionSim local observation capture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "captured_at",
    "instance_name",
    "adb_serial",
    "game_input_performed",
    "adb_server_ownership_verified",
    "artifacts",
    "redaction_status",
    "redaction_regions",
    "annotations",
    "contains_sensitive_content",
    "local_research_only",
    "distribution_allowed"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capture_id": {"$ref": "#/$defs/captureId"},
    "captured_at": {"type": "string", "minLength": 1},
    "instance_name": {"type": "string", "minLength": 1},
    "adb_serial": {"type": "string", "minLength": 1},
    "game_input_performed": {"const": false},
    "adb_server_ownership_verified": {"const": true},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "redaction_status": {
      "enum": ["unreviewed", "annotated", "cleared_local_only"]
    },
    "redaction_regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/redactionRegion"}
    },
    "annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/annotation"}
    },
    "contains_sensitive_content": {"type": ["boolean", "null"]},
    "local_research_only": {"const": true},
    "distribution_allowed": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["redaction_status"],
        "properties": {"redaction_status": {"const": "unreviewed"}}
      },
      "then": {
        "properties": {"contains_sensitive_content": {"const": null}}
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256Prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^capture-[0-9a-f]{64}$"
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "media_type",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "kind": {"enum": ["screenshot", "ui_hierarchy"]},
        "relative_path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "byte_size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256Prefixed"}
      }
    },
    "redactionRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "box", "reason"],
      "properties": {
        "region_id": {"$ref": "#/$defs/stableId"},
        "box": {"$ref": "#/$defs/box"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "label",
        "source",
        "confidence_ppm",
        "artifact_id",
        "box",
        "value"
      ],
      "properties": {
        "annotation_id": {"$ref": "#/$defs/stableId"},
        "label": {"type": "string", "minLength": 1},
        "source": {"enum": ["human", "detector", "ui_metadata"]},
        "confidence_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "box": {"oneOf": [{"$ref": "#/$defs/box"}, {"type": "null"}]},
        "value": {}
      }
    }
  }
}
