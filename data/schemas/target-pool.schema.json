{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:target-pool:1",
  "title": "SIM-02 Eligible Pokémon Target Pool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "regulation_id", "regulation_revision",
    "expected_member_count", "source_manifest_ids", "members"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "regulation_revision": {"$ref": "#/$defs/stableId"},
    "expected_member_count": {"type": "integer", "minimum": 1},
    "source_manifest_ids": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/stableId"}, "uniqueItems": true
    },
    "members": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/member"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string", "minLength": 1, "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["national_dex_no", "form_code", "variant_code", "label", "pokemon_id"],
      "properties": {
        "national_dex_no": {"type": "integer", "minimum": 1},
        "form_code": {"type": "string", "pattern": "^[0-9A-Za-z_-]{2,}$"},
        "variant_code": {"type": "string", "pattern": "^[0-9A-Za-z_-]+$"},
        "label": {"type": "string", "minLength": 1},
        "pokemon_id": {
          "oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]
        }
      }
    }
  }
}
