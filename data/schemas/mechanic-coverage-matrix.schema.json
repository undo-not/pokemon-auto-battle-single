{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:mechanic-coverage-matrix:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "target_capability_set_id", "target_capability_set_hash", "execution_registry_hash", "grounding_assertion_set_hash", "probe_report_hash", "holdout_report_hash", "denominator_final", "declared_target_capability_count", "fully_supported_target_capability_count", "target_pool_execution_coverage_rate_ppm", "required_grounding_requirement_count", "passed_grounding_requirement_count", "verified_grounding_conformance_rate_ppm", "silent_fallback_count", "rows", "unresolved_requirements", "coverage_complete", "candidate_ready", "blocking_reasons"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "matrix_id": {"$ref": "#/$defs/id"}, "target_capability_set_id": {"$ref": "#/$defs/id"}, "target_capability_set_hash": {"$ref": "#/$defs/sha"}, "execution_registry_hash": {"$ref": "#/$defs/sha"}, "grounding_assertion_set_hash": {"$ref": "#/$defs/sha"}, "probe_report_hash": {"$ref": "#/$defs/sha"}, "holdout_report_hash": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "denominator_final": {"type": "boolean"},
    "declared_target_capability_count": {"type": ["integer", "null"], "minimum": 0}, "fully_supported_target_capability_count": {"type": ["integer", "null"], "minimum": 0}, "target_pool_execution_coverage_rate_ppm": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000}, "required_grounding_requirement_count": {"type": ["integer", "null"], "minimum": 0}, "passed_grounding_requirement_count": {"type": ["integer", "null"], "minimum": 0}, "verified_grounding_conformance_rate_ppm": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000}, "silent_fallback_count": {"type": "integer", "minimum": 0},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}, "unresolved_requirements": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}}, "coverage_complete": {"type": "boolean"}, "candidate_ready": {"type": "boolean"}, "blocking_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"}, "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimension": {"type": "object", "additionalProperties": false, "required": ["dimension", "status", "contract_id", "test_ids"], "properties": {"dimension": {"enum": ["legality", "transition", "rng", "event", "observation", "replay"]}, "status": {"enum": ["pass", "fail", "missing"]}, "contract_id": {"$ref": "#/$defs/id"}, "test_ids": {"$ref": "#/$defs/ids"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["capability_id", "entity_ref_ids", "execution_dimensions", "grounding_requirement_ids", "passed_grounding_requirement_ids", "probe_ids", "fully_supported", "grounding_complete", "blockers"], "properties": {"capability_id": {"$ref": "#/$defs/id"}, "entity_ref_ids": {"$ref": "#/$defs/ids"}, "execution_dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}}, "grounding_requirement_ids": {"$ref": "#/$defs/ids"}, "passed_grounding_requirement_ids": {"$ref": "#/$defs/ids"}, "probe_ids": {"$ref": "#/$defs/ids"}, "fully_supported": {"type": "boolean"}, "grounding_complete": {"type": "boolean"}, "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "unresolved": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "kind", "subject_ref", "evidence_ref_ids", "blocker_code"], "properties": {"requirement_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "subject_ref": {"type": "string", "minLength": 1}, "evidence_ref_ids": {"$ref": "#/$defs/ids"}, "blocker_code": {"type": "string", "minLength": 1}}}
  }
}
