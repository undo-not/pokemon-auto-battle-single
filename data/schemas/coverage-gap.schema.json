{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:coverage-gap:1",
  "title": "SIM-02 Regulation Coverage Gap Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "regulation_id", "regulation_revision",
    "regulation_hash", "target_pool_id", "target_pool_hash", "catalog_id",
    "catalog_hash", "ruleset_id", "ruleset_hash", "eligible_member_count",
    "mapped_member_count", "covered_member_count", "covered_pokemon_ids",
    "missing_pokemon_ids", "unmapped_target_keys", "required_mechanics",
    "unsupported_mechanics", "coverage_complete", "blocking_reasons",
    "source_manifest_ids", "restricted_source_manifest_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"$ref": "#/$defs/stableId"},
    "regulation_id": {"$ref": "#/$defs/stableId"},
    "regulation_revision": {"$ref": "#/$defs/stableId"},
    "regulation_hash": {"$ref": "#/$defs/sha256"},
    "target_pool_id": {"$ref": "#/$defs/stableId"},
    "target_pool_hash": {"$ref": "#/$defs/sha256"},
    "catalog_id": {"$ref": "#/$defs/stableId"},
    "catalog_hash": {"$ref": "#/$defs/sha256"},
    "ruleset_id": {"$ref": "#/$defs/stableId"},
    "ruleset_hash": {"$ref": "#/$defs/sha256"},
    "eligible_member_count": {"type": "integer", "minimum": 1},
    "mapped_member_count": {"type": "integer", "minimum": 0},
    "covered_member_count": {"type": "integer", "minimum": 0},
    "covered_pokemon_ids": {"$ref": "#/$defs/stableIds"},
    "missing_pokemon_ids": {"$ref": "#/$defs/stableIds"},
    "unmapped_target_keys": {"$ref": "#/$defs/stableIds"},
    "required_mechanics": {"$ref": "#/$defs/stableIds"},
    "unsupported_mechanics": {"$ref": "#/$defs/stableIds"},
    "coverage_complete": {"type": "boolean"},
    "blocking_reasons": {"$ref": "#/$defs/stableIds"},
    "source_manifest_ids": {"$ref": "#/$defs/stableIds"},
    "restricted_source_manifest_ids": {"$ref": "#/$defs/stableIds"}
  },
  "$defs": {
    "stableId": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "stableIds": {
      "type": "array", "items": {"$ref": "#/$defs/stableId"}, "uniqueItems": true
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
