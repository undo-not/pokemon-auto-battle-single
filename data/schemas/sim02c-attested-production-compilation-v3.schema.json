{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:champions_sim:schema:sim02c-attested-production-compilation-v3:3",
  "title": "SIM-02C Attested Production Promotion Compilation V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compilation_id", "compiler_id", "authorization_status",
    "current_trust_context_required", "attestation_scope", "champions_candidate",
    "champions_fidelity_status", "rank1_equivalence_status", "input_manifest_id",
    "input_manifest_hash", "input_content_hash", "request_binding_hash",
    "replay_binding_hash", "base_compilation_id", "base_compilation_hash",
    "base_promotion_report_hash", "trust_attestation_id", "trust_attestation_hash",
    "trust_subject_hash", "stable_trust_binding_hash", "trust_policy_id",
    "trust_policy_epoch", "trust_policy_sha256", "trust_issuer_id", "trust_key_id",
    "trust_key_fingerprint_sha256", "trust_ledger_binding_hash",
    "trust_registry_id", "trust_registry_sha256", "trust_enrollment_id",
    "trust_enrollment_binding_hash", "trust_enrollment_minimum_policy_epoch",
    "trust_enrollment_ssh_keygen_sha256", "trust_ledger_instance_id",
    "trust_ledger_path_binding_hash", "regulation_id",
    "regulation_revision", "regulation_hash", "target_pool_id", "target_pool_hash",
    "source_authority_subject_hash", "documents", "document_set_hash",
    "compilation_hash"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "compilation_id": {"$ref": "#/$defs/id"},
    "compiler_id": {"const": "champions-production-promotion-v3"},
    "authorization_status": {"const": "not_authorization"},
    "current_trust_context_required": {"const": true},
    "attestation_scope": {"const": "production_champions"},
    "champions_candidate": {"const": true},
    "champions_fidelity_status": {"const": "evidence_attested"},
    "rank1_equivalence_status": {"const": "unmeasured"},
    "input_manifest_id": {"$ref": "#/$defs/id"},
    "input_manifest_hash": {"$ref": "#/$defs/sha"},
    "input_content_hash": {"$ref": "#/$defs/sha"},
    "request_binding_hash": {"$ref": "#/$defs/sha"},
    "replay_binding_hash": {"$ref": "#/$defs/sha"},
    "base_compilation_id": {"$ref": "#/$defs/id"},
    "base_compilation_hash": {"$ref": "#/$defs/sha"},
    "base_promotion_report_hash": {"$ref": "#/$defs/sha"},
    "trust_attestation_id": {"$ref": "#/$defs/id"},
    "trust_attestation_hash": {"$ref": "#/$defs/sha"},
    "trust_subject_hash": {"$ref": "#/$defs/sha"},
    "stable_trust_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_policy_id": {"$ref": "#/$defs/id"},
    "trust_policy_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "trust_policy_sha256": {"$ref": "#/$defs/sha"},
    "trust_issuer_id": {"$ref": "#/$defs/id"},
    "trust_key_id": {"$ref": "#/$defs/id"},
    "trust_key_fingerprint_sha256": {"$ref": "#/$defs/fingerprint"},
    "trust_ledger_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_registry_id": {"$ref": "#/$defs/id"},
    "trust_registry_sha256": {"$ref": "#/$defs/sha"},
    "trust_enrollment_id": {"$ref": "#/$defs/id"},
    "trust_enrollment_binding_hash": {"$ref": "#/$defs/sha"},
    "trust_enrollment_minimum_policy_epoch": {"type": "integer", "minimum": 1},
    "trust_enrollment_ssh_keygen_sha256": {"$ref": "#/$defs/sha"},
    "trust_ledger_instance_id": {"$ref": "#/$defs/id"},
    "trust_ledger_path_binding_hash": {"$ref": "#/$defs/sha"},
    "regulation_id": {"$ref": "#/$defs/id"},
    "regulation_revision": {"$ref": "#/$defs/id"},
    "regulation_hash": {"$ref": "#/$defs/sha"},
    "target_pool_id": {"$ref": "#/$defs/id"},
    "target_pool_hash": {"$ref": "#/$defs/sha"},
    "source_authority_subject_hash": {"$ref": "#/$defs/sha"},
    "documents": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"allOf": [
          {"$ref": "#/$defs/document"},
          {"properties": {"file_name": {"const": "production-promotion-compilation-v2.json"}}}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/document"},
          {"properties": {"file_name": {"const": "production-promotion-input-manifest-v3.json"}}}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/document"},
          {"properties": {"file_name": {"const": "production-trust-attestation-v1.json"}}}
        ]},
        {"allOf": [
          {"$ref": "#/$defs/document"},
          {"properties": {"file_name": {"const": "production-trust-authorization-binding-v1.json"}}}
        ]}
      ],
      "items": false
    },
    "document_set_hash": {"$ref": "#/$defs/sha"},
    "compilation_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["file_name", "sha256", "byte_count"],
      "properties": {
        "file_name": {
          "enum": [
            "production-promotion-input-manifest-v3.json",
            "production-promotion-compilation-v2.json",
            "production-trust-attestation-v1.json",
            "production-trust-authorization-binding-v1.json"
          ]
        },
        "sha256": {"$ref": "#/$defs/sha"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
